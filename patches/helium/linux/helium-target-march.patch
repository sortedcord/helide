--- a/build/config/compiler_cpu_abi.gn
+++ b/build/config/compiler_cpu_abi.gn
@@ -20,6 +20,14 @@
     # target_cpu="arm64" may set cros_target_cpu_arch="armv8-a+crc+crypto").
     cros_target_cpu_arch = ""
   }
+}
+
+declare_args() {
+  # Helium: generate code for a specific x86-64 CPU, for example
+  # helium_target_march="arrowlake". The browser then only runs on CPUs that
+  # support it. Empty keeps the generic x86-64 baseline. Linux x64 target
+  # toolchain only.
+  helium_target_march = ""
 }
 
 cpu_abi_cflags = []
@@ -56,6 +64,12 @@
       cpu_abi_ldflags += [ "-m64" ]
     }
     cpu_abi_cflags += [ "-msse3" ]
+    if (helium_target_march != "" && is_clang && is_linux &&
+        is_a_target_toolchain) {
+      # The linker needs it too: ThinLTO generates the code at link time.
+      cpu_abi_cflags += [ "-march=$helium_target_march" ]
+      cpu_abi_ldflags += [ "-march=$helium_target_march" ]
+    }
     if (target_os == "chromeos" && cros_target_cpu_arch != "" &&
         is_a_target_toolchain) {
       cpu_abi_cflags += [ "-march=$cros_target_cpu_arch" ]
