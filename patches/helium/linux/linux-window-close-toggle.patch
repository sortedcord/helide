+bool ShouldShowWindowCloseButton(BrowserView* browser_view) {
+  // Popups and app windows keep their close control regardless of the toolbar
+  // preference. Compositor-owned server decorations are outside our control.
+  return browser_view->browser()->GetType() !=
+             BrowserWindowInterface::TYPE_NORMAL ||
+         browser_view->GetProfile()->GetPrefs()->GetBoolean(
+             helium::kShowWindowCloseButton);
+}
+
+bool HasCaptionButtons(const std::vector<views::FrameButton>& buttons,
+                       BrowserView* browser_view) {
+  const bool show_close = ShouldShowWindowCloseButton(browser_view);
+  return std::ranges::any_of(buttons, [show_close](views::FrameButton button) {
+    return show_close || button != views::FrameButton::kClose;
+  });
+}
