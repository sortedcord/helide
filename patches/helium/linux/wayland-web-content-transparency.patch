+void ClipWaylandWebContents(gfx::Canvas* canvas,
+                            BrowserView* browser_view,
+                            const views::View* frame_view) {
+  if (!ShouldAllowWaylandWebTransparency(browser_view)) {
+    return;
+  }
+  // Use the live page bounds, not the whole contents container: this preserves
+  // frame tint in rounded corners, split gutters, sidebars and docked devtools.
+  for (auto* contents : browser_view->GetAllVisibleContentsWebViews()) {
+    if (!contents || !contents->IsDrawn() || contents->size().IsEmpty()) {
+      continue;
+    }
+    const gfx::Rect bounds = views::View::ConvertRectToTarget(
+        contents, frame_view, contents->GetLocalBounds());
+    canvas->sk_canvas()->clipRRect(
+        gfx::RoundedRectToSkRRect(bounds, contents->GetBackgroundRadii()),
+        SkClipOp::kDifference, true);
+  }
+}
+
+void ScheduleWaylandFramePaint(views::View* view) {
+  if (ShouldAllowWaylandWebTransparency(view)) {
+    views::Widget* widget = view->GetWidget();
+    if (widget->non_client_view()) {
+      widget->non_client_view()->SchedulePaint();
+    }
+  }
