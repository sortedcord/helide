+
+namespace content {
+class WebContents;
+}
+
+// Tabs opened by AI agents and other DevTools protocol clients (see the "Let AI
+// agents control Helium" setting). They open in the background, in a collapsed
+// "Agent" tab group at the end of the tab strip, never take focus from the
+// user, and keep rendering at full speed while hidden, so that the agent can
+// use them while the user keeps working in the same window.
+namespace helium::agent {
+
+// True if the user turned on agent access in Settings.
+bool IsAgentAccessEnabled();
+
+// True if `contents` was opened by an agent.
+bool IsAgentTab(content::WebContents* contents);
+
+// Marks `contents`, which has just been added to a tab strip, as an agent tab:
+// moves it into the Agent group (creating the group if needed) and keeps its
+// renderer awake while the tab is hidden. Safe to call more than once.
+void AdoptAgentTab(content::WebContents* contents);
+
+}  // namespace helium::agent
