+
+namespace helium::agent {
+
+namespace {
+
+// Attached to every agent tab. While it lives, the renderer is told that the
+// page is visible even when the tab is in the background, which keeps timers,
+// animation frames and screenshots working. It does not show a capture
+// indicator and does not count as user activity.
+class AgentTabState : public content::WebContentsUserData<AgentTabState> {
+ public:
+  ~AgentTabState() override = default;
+
+ private:
+  friend class content::WebContentsUserData<AgentTabState>;
+
+  explicit AgentTabState(content::WebContents* contents)
+      : content::WebContentsUserData<AgentTabState>(*contents),
+        keep_awake_(contents->IncrementCapturerCount(
+            gfx::Size(),
+            /*stay_hidden=*/false,
+            /*stay_awake=*/false,
+            /*is_activity=*/false)) {}
+
+  base::ScopedClosureRunner keep_awake_;
+
+  WEB_CONTENTS_USER_DATA_KEY_DECL();
+};
+
+WEB_CONTENTS_USER_DATA_KEY_IMPL(AgentTabState);
+
+// The group that already holds agent tabs in `model`, if any. Found through
+// its tabs so that it keeps working when the user renames or recolors it.
+std::optional<tab_groups::TabGroupId> FindAgentGroup(TabStripModel* model) {
+  for (int i = 0; i < model->count(); ++i) {
+    if (!AgentTabState::FromWebContents(model->GetWebContentsAt(i))) {
+      continue;
+    }
+    if (auto group = model->GetTabGroupForTab(i)) {
+      return group;
+    }
+  }
+  return std::nullopt;
+}
+
+}  // namespace
+
+bool IsAgentAccessEnabled() {
+  return g_browser_process && g_browser_process->local_state() &&
+         g_browser_process->local_state()->GetBoolean(
+             prefs::kHeliumAgentAccessEnabled);
+}
+
+bool IsAgentTab(content::WebContents* contents) {
+  return contents && AgentTabState::FromWebContents(contents);
+}
+
+void AdoptAgentTab(content::WebContents* contents) {
+  if (!contents) {
+    return;
+  }
+  AgentTabState::CreateForWebContents(contents);
+
+  tabs::TabInterface* tab = tabs::TabInterface::MaybeGetFromContents(contents);
+  BrowserWindowInterface* window =
+      tab ? tab->GetBrowserWindowInterface() : nullptr;
+  TabStripModel* model = window ? window->GetTabStripModel() : nullptr;
+  if (!model || !model->SupportsTabGroups()) {
+    return;
+  }
+  const int index = model->GetIndexOfWebContents(contents);
+  if (index == TabStripModel::kNoTab) {
+    return;
+  }
+
+  const std::optional<tab_groups::TabGroupId> agent_group =
+      FindAgentGroup(model);
+  if (agent_group) {
+    if (model->GetTabGroupForTab(index) != agent_group) {
+      model->AddToExistingGroup({index}, *agent_group, /*add_to_end=*/true);
+    }
+    return;
+  }
+
+  // Ephemeral: the group is not saved or synced, and is gone with its tabs.
+  const tab_groups::TabGroupId group =
+      model->AddToNewGroup({index}, /*is_ephemeral=*/true);
+  model->ChangeTabGroupVisuals(
+      group, tab_groups::TabGroupVisualData(
+                 u"Agent", tab_groups::TabGroupColorId::kPurple,
+                 /*is_collapsed=*/true));
+  model->MoveGroupTo(group, model->count() - 1);
+}
