+
+constexpr base::TimeDelta kFadeInDuration = base::Milliseconds(110);
+constexpr base::TimeDelta kFadeOutDuration = base::Milliseconds(190);
+// A swipe with no motion for this long has lost its end event.
+constexpr base::TimeDelta kStaleSwipeTimeout = base::Milliseconds(800);
+// Room around the strip for the soft edge of the glow.
+constexpr int kStripClipOutset = 6;
+constexpr float kTabCornerRadius = 8.0f;
+constexpr float kPaneCornerRadius = 12.0f;
+
+gfx::RectF Lerp(const gfx::RectF& a, const gfx::RectF& b, double t) {
+  const auto mix = [t](float from, float to) {
+    return static_cast<float>(from + (to - from) * t);
+  };
+  return gfx::RectF(mix(a.x(), b.x()), mix(a.y(), b.y()),
+                    mix(a.width(), b.width()), mix(a.height(), b.height()));
+}
+
+// Removes the overlay once its fade-out has finished, unless the browser
+// window went away first.
+void RemoveFadedOverlay(std::shared_ptr<views::ViewTracker> tracker) {
+  if (views::View* overlay = tracker->view()) {
+    if (views::View* parent = overlay->parent()) {
+      parent->RemoveChildViewT(overlay);
+    }
+  }
+}
+
+}  // namespace
+
+TabScrubber::TabScrubber(BrowserView* browser_view, views::Widget* widget)
+    : browser_view_(browser_view) {
+  if (!widget) {
+    return;
+  }
+  window_ = widget->GetNativeWindow();
+  if (!window_) {
+    return;
+  }
+  window_->AddPreTargetHandler(this);
+  window_observation_.Observe(window_);
+}
+
+TabScrubber::~TabScrubber() {
+  RemoveOverlay();
+  if (window_) {
+    window_->RemovePreTargetHandler(this);
+  }
+}
+
+void TabScrubber::OnWindowDestroying(aura::Window* window) {
+  window_->RemovePreTargetHandler(this);
+  window_observation_.Reset();
+  window_ = nullptr;
+  RemoveOverlay();
+}
+
+void TabScrubber::OnScrollEvent(ui::ScrollEvent* event) {
+  VLOG(2) << "Tab scrub: scroll event type="
+          << static_cast<int>(event->type())
+          << " fingers=" << event->finger_count()
+          << " x=" << event->x_offset() << " y=" << event->y_offset();
+
+  // The end of a swipe. Aura reports no finger count on these (as in ChromeOS
+  // tab scrubbing), so they are recognised by the swipe in progress. The end
+  // of an ordinary two-finger scroll arrives here too: leave it to the page.
+  if (event->IsFlingScrollEvent()) {
+    if (state_ == State::kIdle) {
+      return;
+    }
+    event->SetHandled();
+    Finish(/*commit=*/event->type() == ui::EventType::kScrollFlingStart);
+    return;
+  }
+
+  if (event->finger_count() < 3) {
+    return;
+  }
+
+  // A swipe with three or more fingers is never a page scroll, even when
+  // the feature is off or the swipe has nothing to do.
+  event->SetHandled();
+  if (event->finger_count() != 3 || event->type() != ui::EventType::kScroll) {
+    return;
+  }
+
+  // A swipe whose end never arrived must not swallow the next one.
+  if (state_ != State::kIdle &&
+      event->time_stamp() - last_motion_time_ > kStaleSwipeTimeout) {
+    Finish(/*commit=*/false);
+  }
+  last_motion_time_ = event->time_stamp();
+  OnMotion(event->x_offset(), event->y_offset());
+}
+
+bool TabScrubber::IsEnabled() {
+  auto* browser_view = static_cast<BrowserView*>(browser_view_.view());
+  return browser_view &&
+         browser_view->GetProfile()->GetPrefs()->GetBoolean(
+             helium::kThreeFingerTabScrub);
+}
+
+void TabScrubber::OnMotion(double dx, double dy) {
+  switch (state_) {
+    case State::kIdle:
+      if (!IsEnabled()) {
+        state_ = State::kIgnored;
+        return;
+      }
+      axis_lock_ = SwipeAxisLock();
+      axis_ = SwipeAxisLock::Axis::kUndecided;
+      state_ = State::kUndecided;
+      [[fallthrough]];
+    case State::kUndecided: {
+      const SwipeAxisLock::Axis axis = axis_lock_.Add(dx, dy);
+      if (axis != SwipeAxisLock::Axis::kUndecided) {
+        StartScrubbing(axis, axis_lock_.TakeCarry());
+      }
+      return;
+    }
+    case State::kScrubbing: {
+      position_->Move(axis_ == SwipeAxisLock::Axis::kHorizontal ? dx : dy);
+      if (!Refresh()) {
+        // The tabs changed under the swipe. Stop following it, and do not
+        // switch to anything when the fingers lift.
+        RemoveOverlay();
+        position_.reset();
+        state_ = State::kIgnored;
+      }
+      return;
+    }
+    case State::kIgnored:
+      return;
+  }
+}
+
+void TabScrubber::StartScrubbing(SwipeAxisLock::Axis axis, double carry) {
+  axis_ = axis;
+  const bool started = axis == SwipeAxisLock::Axis::kVertical
+                           ? StartTabScrub()
+                           : StartPaneScrub();
+  auto* browser_view = static_cast<BrowserView*>(browser_view_.view());
+  if (!started || !browser_view) {
+    VLOG(1) << "Tab scrub: nothing to scrub on the "
+            << (axis == SwipeAxisLock::Axis::kVertical ? "vertical"
+                                                        : "horizontal")
+            << " axis";
+    position_.reset();
+    state_ = State::kIgnored;
+    return;
+  }
+  VLOG(1) << "Tab scrub: started on the "
+          << (axis == SwipeAxisLock::Axis::kVertical ? "vertical"
+                                                      : "horizontal")
+          << " axis with " << position_->count() << " items";
+
+  auto overlay = std::make_unique<TabScrubGlowView>();
+  overlay->SetBoundsRect(browser_view->GetLocalBounds());
+  views::View* added = browser_view->AddChildView(std::move(overlay));
+  overlay_.SetView(added);
+  added->layer()->SetOpacity(0.0f);
+  views::AnimationBuilder()
+      .Once()
+      .SetDuration(kFadeInDuration)
+      .SetOpacity(added->layer(), 1.0f, gfx::Tween::EASE_OUT);
+
+  position_->Move(carry);
+  state_ = State::kScrubbing;
+  if (!Refresh()) {
+    RemoveOverlay();
+    position_.reset();
+    state_ = State::kIgnored;
+  }
+}
+
+bool TabScrubber::StartTabScrub() {
+  auto* browser_view = static_cast<BrowserView*>(browser_view_.view());
+  if (!browser_view) {
+    return false;
+  }
+  const std::vector<TabItem> items = GatherTabs();
+  if (items.size() < 2) {
+    return false;
+  }
+  const int active =
+      browser_view->browser()->GetTabStripModel()->active_index();
+  const auto it = std::ranges::find(items, active, &TabItem::model_index);
+  if (it == items.end()) {
+    return false;
+  }
+  const int start = static_cast<int>(it - items.begin());
+  start_model_index_ = active;
+  last_scrolled_item_ = start;
+  position_.emplace(static_cast<int>(items.size()), start,
+                    ScrubPosition::TravelPerTab(static_cast<int>(items.size())));
+  return true;
+}
+
+bool TabScrubber::StartPaneScrub() {
+  auto* browser_view = static_cast<BrowserView*>(browser_view_.view());
+  if (!browser_view) {
+    return false;
+  }
+  const std::vector<PaneItem> panes = GatherPanes();
+  if (panes.size() != 2) {
+    return false;
+  }
+  const int active =
+      browser_view->browser()->GetTabStripModel()->active_index();
+  const auto it = std::ranges::find(panes, active, &PaneItem::model_index);
+  if (it == panes.end()) {
+    return false;
+  }
+  start_model_index_ = active;
+  last_scrolled_item_ = -1;
+  position_.emplace(2, static_cast<int>(it - panes.begin()),
+                    ScrubPosition::kTravelPerPane);
+  return true;
+}
+
+void TabScrubber::Finish(bool commit) {
+  auto* browser_view = static_cast<BrowserView*>(browser_view_.view());
+  std::optional<int> target_model_index;
+
+  if (state_ == State::kScrubbing && position_ && browser_view) {
+    position_->SnapToNearest();
+    if (Refresh() && commit) {
+      const int nearest = position_->NearestIndex();
+      if (axis_ == SwipeAxisLock::Axis::kVertical) {
+        const std::vector<TabItem> items = GatherTabs();
+        if (nearest < static_cast<int>(items.size())) {
+          target_model_index = items[nearest].model_index;
+        }
+      } else {
+        const std::vector<PaneItem> panes = GatherPanes();
+        if (nearest < static_cast<int>(panes.size())) {
+          target_model_index = panes[nearest].model_index;
+        }
+      }
+    }
+  }
+
+  // Let the glow settle on the landing tab and fade, then drop it.
+  if (views::View* overlay = overlay_.view()) {
+    overlay_.SetView(nullptr);
+    auto tracker = std::make_shared<views::ViewTracker>(overlay);
+    views::AnimationBuilder()
+        .OnEnded(base::BindOnce(&RemoveFadedOverlay, tracker))
+        .OnAborted(base::BindOnce(&RemoveFadedOverlay, tracker))
+        .Once()
+        .SetDuration(kFadeOutDuration)
+        .SetOpacity(overlay->layer(), 0.0f, gfx::Tween::EASE_IN);
+  }
+
+  position_.reset();
+  state_ = State::kIdle;
+  axis_ = SwipeAxisLock::Axis::kUndecided;
+
+  VLOG(1) << "Tab scrub: finished, commit=" << commit << " target="
+          << (target_model_index ? *target_model_index : -1);
+  if (target_model_index && browser_view) {
+    TabStripModel* model = browser_view->browser()->GetTabStripModel();
+    if (*target_model_index != model->active_index() &&
+        model->ContainsIndex(*target_model_index)) {
+      model->ActivateTabAt(
+          *target_model_index,
+          TabStripUserGestureDetails(
+              TabStripUserGestureDetails::GestureType::kOther));
+    }
+  }
+}
+
+void TabScrubber::RemoveOverlay() {
+  if (views::View* overlay = overlay_.view()) {
+    overlay_.SetView(nullptr);
+    if (views::View* parent = overlay->parent()) {
+      parent->RemoveChildViewT(overlay);
+    }
+  }
+}
+
+bool TabScrubber::Refresh() {
+  auto* browser_view = static_cast<BrowserView*>(browser_view_.view());
+  auto* overlay = static_cast<TabScrubGlowView*>(overlay_.view());
+  if (!browser_view || !overlay || !position_) {
+    return false;
+  }
+  overlay->SetBoundsRect(browser_view->GetLocalBounds());
+
+  const int low = position_->FloorIndex();
+  const int high = std::min(low + 1, position_->count() - 1);
+  const double fraction = position_->Fraction();
+
+  std::optional<gfx::Rect> strip_clip;
+  if (TabStripView* strip = FindTabStripView()) {
+    strip_clip = gfx::ToEnclosingRect(BoundsInBrowserView(strip));
+    strip_clip->Outset(kStripClipOutset);
+  }
+
+  std::vector<TabScrubGlowView::Shape> shapes;
+  const std::vector<TabItem> tabs = GatherTabs();
+
+  if (axis_ == SwipeAxisLock::Axis::kVertical) {
+    if (static_cast<int>(tabs.size()) != position_->count() ||
+        tabs[position_->start_index()].model_index != start_model_index_) {
+      return false;
+    }
+    TabScrubGlowView::Shape tab_shape;
+    tab_shape.bounds = Lerp(BoundsInBrowserView(tabs[low].view),
+                            BoundsInBrowserView(tabs[high].view), fraction);
+    tab_shape.corner_radius = kTabCornerRadius;
+    tab_shape.clip = strip_clip;
+    shapes.push_back(tab_shape);
+
+    const int nearest = position_->NearestIndex();
+    if (nearest != last_scrolled_item_) {
+      last_scrolled_item_ = nearest;
+      ScrollTabIntoView(nearest);
+    }
+  } else {
+    const std::vector<PaneItem> panes = GatherPanes();
+    if (panes.size() != 2 ||
+        panes[position_->start_index()].model_index != start_model_index_) {
+      return false;
+    }
+    TabScrubGlowView::Shape pane_shape;
+    pane_shape.bounds = Lerp(BoundsInBrowserView(panes[low].container),
+                             BoundsInBrowserView(panes[high].container),
+                             fraction);
+    pane_shape.corner_radius = kPaneCornerRadius;
+    pane_shape.is_pane = true;
+    shapes.push_back(pane_shape);
+
+    // The tab each pane belongs to glows in the strip too.
+    const auto tab_for = [&tabs](int model_index) -> const views::View* {
+      for (const TabItem& item : tabs) {
+        if (item.model_index == model_index) {
+          return item.view;
+        }
+      }
+      return nullptr;
+    };
+    const views::View* low_tab = tab_for(panes[low].model_index);
+    const views::View* high_tab = tab_for(panes[high].model_index);
+    if (low_tab && high_tab) {
+      TabScrubGlowView::Shape tab_shape;
+      tab_shape.bounds = Lerp(BoundsInBrowserView(low_tab),
+                              BoundsInBrowserView(high_tab), fraction);
+      tab_shape.corner_radius = kTabCornerRadius;
+      tab_shape.clip = strip_clip;
+      shapes.push_back(tab_shape);
+    }
+  }
+
+  overlay->SetShapes(std::move(shapes));
+  return true;
+}
+
+std::vector<TabScrubber::TabItem> TabScrubber::GatherTabs() {
+  std::vector<TabItem> items;
+  auto* browser_view = static_cast<BrowserView*>(browser_view_.view());
+  if (!browser_view) {
+    return items;
+  }
+  views::View* strip_region = browser_view->tab_strip_view();
+  if (!strip_region) {
+    return items;
+  }
+  TabStripModel* model = browser_view->browser()->GetTabStripModel();
+
+  std::vector<views::View*> pending = {strip_region};
+  while (!pending.empty()) {
+    views::View* view = pending.back();
+    pending.pop_back();
+    // The collection-based tab strip, which also draws the vertical layout.
+    if (TabView* tab_view = views::AsViewClass<TabView>(view)) {
+      if (tab_view->IsClosing() || !tab_view->IsDrawn()) {
+        continue;
+      }
+      if (const tabs::TabInterface* tab_interface =
+              tab_view->GetTabInterface()) {
+        const int index = model->GetIndexOfTab(tab_interface);
+        if (index >= 0) {
+          items.push_back({tab_view, index});
+        }
+      }
+      continue;
+    }
+    if (Tab* tab = views::AsViewClass<Tab>(view)) {
+      if (tab->closing() || !tab->IsDrawn()) {
+        continue;
+      }
+      if (tabs::TabInterface* tab_interface = tab->tab_handle().Get()) {
+        const int index = model->GetIndexOfTab(tab_interface);
+        if (index >= 0) {
+          items.push_back({tab, index});
+        }
+      }
+      continue;
+    }
+    for (views::View* child : view->children()) {
+      pending.push_back(child);
+    }
+  }
+
+  std::ranges::sort(items, {}, &TabItem::model_index);
+  const auto duplicates = std::ranges::unique(
+      items, [](const TabItem& a, const TabItem& b) {
+        return a.model_index == b.model_index;
+      });
+  items.erase(duplicates.begin(), duplicates.end());
+  return items;
+}
+
+std::vector<TabScrubber::PaneItem> TabScrubber::GatherPanes() {
+  std::vector<PaneItem> panes;
+  auto* browser_view = static_cast<BrowserView*>(browser_view_.view());
+  if (!browser_view) {
+    return panes;
+  }
+  MultiContentsView* multi = browser_view->multi_contents_view();
+  if (!multi || !multi->IsInSplitView()) {
+    return panes;
+  }
+  TabStripModel* model = browser_view->browser()->GetTabStripModel();
+  for (ContentsContainerView* container :
+       {multi->GetActiveContentsContainerView(),
+        multi->GetInactiveContentsContainerView()}) {
+    if (!container || !container->contents_view()) {
+      return {};
+    }
+    content::WebContents* contents = container->contents_view()->web_contents();
+    const int index = contents ? model->GetIndexOfWebContents(contents) : -1;
+    if (index < 0) {
+      return {};
+    }
+    panes.push_back({container, index});
+  }
+  // Visual order, left to right, whichever pane is active.
+  std::ranges::sort(panes, {}, [this](const PaneItem& pane) {
+    return BoundsInBrowserView(pane.container).x();
+  });
+  return panes;
+}
+
+TabStripView* TabScrubber::FindTabStripView() {
+  auto* browser_view = static_cast<BrowserView*>(browser_view_.view());
+  if (!browser_view || !browser_view->tab_strip_view()) {
+    return nullptr;
+  }
+  std::vector<views::View*> pending = {browser_view->tab_strip_view()};
+  while (!pending.empty()) {
+    views::View* view = pending.back();
+    pending.pop_back();
+    if (TabStripView* strip = views::AsViewClass<TabStripView>(view)) {
+      return strip;
+    }
+    for (views::View* child : view->children()) {
+      pending.push_back(child);
+    }
+  }
+  return nullptr;
+}
+
+gfx::RectF TabScrubber::BoundsInBrowserView(const views::View* view) {
+  const auto* browser_view = static_cast<BrowserView*>(browser_view_.view());
+  return views::View::ConvertRectToTarget(
+      view, browser_view, gfx::RectF(view->GetLocalBounds()));
+}
+
+void TabScrubber::ScrollTabIntoView(int item_index) {
+  const std::vector<TabItem> items = GatherTabs();
+  if (item_index < 0 || item_index >= static_cast<int>(items.size())) {
+    return;
+  }
+  if (TabStripView* strip = FindTabStripView()) {
+    strip->ScrollToFitViews(items[item_index].view, nullptr);
+  }
+}
+
