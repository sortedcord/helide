+#include "chrome/browser/ui/views/helium/helium_tab_scrub_model.h"
+
+#include <algorithm>
+#include <cmath>
+
+namespace helium {
+
+SwipeAxisLock::Axis SwipeAxisLock::Add(double dx, double dy) {
+  if (axis_ != Axis::kUndecided || !std::isfinite(dx) || !std::isfinite(dy)) {
+    return axis_;
+  }
+  total_x_ += dx;
+  total_y_ += dy;
+  if (std::hypot(total_x_, total_y_) < kLockDistance) {
+    return axis_;
+  }
+  axis_ = std::abs(total_x_) > std::abs(total_y_) ? Axis::kHorizontal
+                                                  : Axis::kVertical;
+  return axis_;
+}
+
+double SwipeAxisLock::TakeCarry() {
+  if (carry_taken_ || axis_ == Axis::kUndecided) {
+    return 0.0;
+  }
+  carry_taken_ = true;
+  return axis_ == Axis::kHorizontal ? total_x_ : total_y_;
+}
+
+// static
+double ScrubPosition::TravelPerTab(int tab_count) {
+  // 28 DIPs per tab for a few tabs, up to 64 for a very long strip.
+  return 28.0 + 0.9 * std::clamp(tab_count, 0, 40);
+}
+
+ScrubPosition::ScrubPosition(int count, int start_index, double travel_per_item)
+    : count_(std::max(count, 1)),
+      start_index_(std::clamp(start_index, 0, std::max(count, 1) - 1)),
+      travel_per_item_(std::max(travel_per_item, 1.0)),
+      position_(start_index_) {}
+
+void ScrubPosition::Move(double finger_travel) {
+  if (!std::isfinite(finger_travel)) {
+    return;
+  }
+  position_ = std::clamp(position_ + finger_travel / travel_per_item_, 0.0,
+                         static_cast<double>(count_ - 1));
+}
+
+int ScrubPosition::NearestIndex() const {
+  return std::clamp(static_cast<int>(std::lround(position_)), 0, count_ - 1);
+}
+
+void ScrubPosition::SnapToNearest() {
+  position_ = NearestIndex();
+}
+
+int ScrubPosition::FloorIndex() const {
+  return std::clamp(static_cast<int>(std::floor(position_)), 0, count_ - 1);
+}
+
+double ScrubPosition::Fraction() const {
+  return std::clamp(position_ - FloorIndex(), 0.0, 1.0);
+}
+
