+#ifndef CHROME_BROWSER_UI_VIEWS_HELIUM_HELIUM_TAB_SCRUB_MODEL_H_
+#define CHROME_BROWSER_UI_VIEWS_HELIUM_HELIUM_TAB_SCRUB_MODEL_H_
+
+// Math for three-finger tab scrubbing. Kept free of Chromium dependencies so
+// it can be tested on its own.
+
+namespace helium {
+
+// Decides which axis a swipe moves along, from its first frames of motion.
+class SwipeAxisLock {
+ public:
+  enum class Axis { kUndecided, kHorizontal, kVertical };
+
+  // Finger travel, in DIPs, before an axis is chosen. Below this a resting
+  // hand does not start anything.
+  static constexpr double kLockDistance = 12.0;
+
+  // Adds one frame of finger motion and returns the axis. It is
+  // kUndecided until the motion is large enough, and never changes afterwards.
+  Axis Add(double dx, double dy);
+
+  Axis axis() const { return axis_; }
+
+  // Motion along the chosen axis that arrived before the axis was chosen, so
+  // that no finger travel is lost. Returns 0 after the first call.
+  double TakeCarry();
+
+ private:
+  Axis axis_ = Axis::kUndecided;
+  double total_x_ = 0.0;
+  double total_y_ = 0.0;
+  bool carry_taken_ = false;
+};
+
+// A continuous position along `count` ordered items (tabs or panes). The
+// position is a real number: 2.5 is halfway between item 2 and item 3. Finger
+// travel moves it directly, with no steps and no wrapping.
+class ScrubPosition {
+ public:
+  // Finger travel needed to move one pane in a split view.
+  static constexpr double kTravelPerPane = 170.0;
+
+  // Finger travel needed to move one tab. Grows with the tab count so that a
+  // long strip stays controllable, as in ChromeOS tab scrubbing.
+  static double TravelPerTab(int tab_count);
+
+  ScrubPosition(int count, int start_index, double travel_per_item);
+
+  // Moves the position by finger travel in DIPs. Positive moves toward higher
+  // indices. The position stops at the first and last item.
+  void Move(double finger_travel);
+
+  double position() const { return position_; }
+  int count() const { return count_; }
+  int start_index() const { return start_index_; }
+
+  // The item the position is closest to. This is where lifting the fingers
+  // lands.
+  int NearestIndex() const;
+
+  // Moves the position onto the nearest item, as when the fingers lift.
+  void SnapToNearest();
+
+  // The item at or before the position, and how far past it the position is
+  // (0 up to, not including, 1). Used to place a glow between two items.
+  int FloorIndex() const;
+  double Fraction() const;
+
+ private:
+  int count_;
+  int start_index_;
+  double travel_per_item_;
+  double position_;
+};
+
+}  // namespace helium
