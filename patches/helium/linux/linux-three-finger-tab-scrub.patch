+
+#ifndef CHROME_BROWSER_UI_VIEWS_HELIUM_HELIUM_TAB_SCRUB_GLOW_VIEW_H_
+#define CHROME_BROWSER_UI_VIEWS_HELIUM_HELIUM_TAB_SCRUB_GLOW_VIEW_H_
+
+#include <optional>
+#include <vector>
+
+#include "ui/base/metadata/metadata_header_macros.h"
+#include "ui/gfx/geometry/rect.h"
+#include "ui/gfx/geometry/rect_f.h"
+#include "ui/views/view.h"
+
+namespace helium {
+
+// A transparent overlay that draws the glow of the tab (or pane) a
+// three-finger swipe would land on. It never takes input.
+class TabScrubGlowView final : public views::View {
+  METADATA_HEADER(TabScrubGlowView, views::View)
+
+ public:
+  struct Shape {
+    // In this view's coordinates.
+    gfx::RectF bounds;
+    float corner_radius = 8.0f;
+    // Glow is cut off outside this area, for tabs scrolled under the edge of
+    // the strip.
+    std::optional<gfx::Rect> clip;
+    // Panes are large, so they get an outline and a faint fill; tabs get a
+    // stronger fill.
+    bool is_pane = false;
+  };
+
+  TabScrubGlowView();
+  TabScrubGlowView(const TabScrubGlowView&) = delete;
+  TabScrubGlowView& operator=(const TabScrubGlowView&) = delete;
+  ~TabScrubGlowView() override;
+
+  void SetShapes(std::vector<Shape> shapes);
+
+  // views::View:
+  void OnPaint(gfx::Canvas* canvas) override;
+
+ private:
+  std::vector<Shape> shapes_;
+};
+
+}  // namespace helium
