+namespace helium {
+
+class TabScrubGlowView;
+
+// Three-finger touchpad swipes that move through tabs, as a continuous
+// action. It is the Linux counterpart of ChromeOS tab scrubbing, extended
+// to two axes:
+//
+//   vertical swipe    - moves through the tabs in the tab strip
+//   horizontal swipe  - moves between the panes of a split view
+//
+// While the fingers are down a glow slides smoothly over the tab (or pane)
+// the swipe would land on. The page does not change until the fingers lift,
+// when the nearest tab becomes active. Nothing moves in steps: finger travel
+// maps straight to a position between tabs.
+//
+// Wayland delivers these swipes as scroll events carrying a finger count (see
+// WaylandEventSource::OnSwipeEvent). This handler runs before the page sees
+// them, so a three-finger swipe never scrolls a web page.
+class TabScrubber final : public ui::EventHandler,
+                          public aura::WindowObserver {
+ public:
+  // `widget` is the browser window the swipes arrive in.
+  TabScrubber(BrowserView* browser_view, views::Widget* widget);
+  TabScrubber(const TabScrubber&) = delete;
+  TabScrubber& operator=(const TabScrubber&) = delete;
+  ~TabScrubber() override;
+
+  // ui::EventHandler:
+  void OnScrollEvent(ui::ScrollEvent* event) override;
+
+  // aura::WindowObserver:
+  void OnWindowDestroying(aura::Window* window) override;
+
+ private:
+  enum class State {
+    // No swipe in progress.
+    kIdle,
+    // Fingers are down but have not moved far enough to choose an axis.
+    kUndecided,
+    // Following the fingers.
+    kScrubbing,
+    // A swipe that does nothing here (no split view, one tab). It is still
+    // consumed so it cannot scroll the page.
+    kIgnored,
+  };
+
+  struct TabItem {
+    // A tab view (TabView in the collection-based strip, Tab in older ones).
+    raw_ptr<views::View> view;
+    int model_index;
+  };
+  struct PaneItem {
+    raw_ptr<views::View> container;
+    int model_index;
+  };
+
+  bool IsEnabled();
+  void OnMotion(double dx, double dy);
+  void StartScrubbing(SwipeAxisLock::Axis axis, double carry);
+  bool StartTabScrub();
+  bool StartPaneScrub();
+  void Finish(bool commit);
+  void EndGesture();
+  void RemoveOverlay();
+
+  // Positions the glow for the current position. Returns false if the tabs
+  // changed under the swipe, which ends it without switching.
+  bool Refresh();
+
+  std::vector<TabItem> GatherTabs();
+  std::vector<PaneItem> GatherPanes();
+  TabStripView* FindTabStripView();
+
+  gfx::RectF BoundsInBrowserView(const views::View* view);
+  void ScrollTabIntoView(int item_index);
+
+  views::ViewTracker browser_view_;
+  raw_ptr<aura::Window> window_ = nullptr;
+  base::ScopedObservation<aura::Window, aura::WindowObserver>
+      window_observation_{this};
+
+  State state_ = State::kIdle;
+  SwipeAxisLock axis_lock_;
+  SwipeAxisLock::Axis axis_ = SwipeAxisLock::Axis::kUndecided;
+  std::optional<ScrubPosition> position_;
+
+  // The tab that was active when the swipe started, to notice changes under
+  // the swipe.
+  int start_model_index_ = -1;
+  // Last tab brought into view, so the strip scrolls only when the target
+  // changes.
+  int last_scrolled_item_ = -1;
+
+  // When the last frame of motion arrived, to drop a swipe whose end was lost.
+  base::TimeTicks last_motion_time_;
+
+  views::ViewTracker overlay_;
+};
+
+}  // namespace helium
