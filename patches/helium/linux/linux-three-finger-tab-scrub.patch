+
+// Helide: three-or-more-finger touchpad swipes. They are delivered the way
+// ChromeOS delivers them to its tab scrubber: as scroll events that carry the
+// finger count. A kScroll event is one frame of finger motion; the session
+// ends with kScrollFlingStart (fingers lifted) or kScrollFlingCancel (the
+// compositor cancelled it). Two-finger scrolling keeps its own path above.
+void WaylandEventSource::OnSwipeEvent(SwipePhase phase,
+                                      uint32_t finger_count,
+                                      const gfx::Vector2dF& delta,
+                                      base::TimeTicks timestamp,
+                                      int device_id) {
+  if (finger_count < 3 || phase == SwipePhase::kBegin) {
+    return;
+  }
+
+  auto* target = window_manager_->GetCurrentPointerFocusedWindow();
+  if (!target) {
+    return;
+  }
+
+  const int flags = pointer_flags_ | keyboard_modifiers_;
+  const int fingers = static_cast<int>(finger_count);
+  std::unique_ptr<ScrollEvent> event;
+  switch (phase) {
+    case SwipePhase::kUpdate:
+      event = std::make_unique<ScrollEvent>(
+          EventType::kScroll, pointer_location_, pointer_location_, timestamp,
+          flags, delta.x(), delta.y(), delta.x(), delta.y(), fingers);
+      break;
+    case SwipePhase::kEnd:
+      event = std::make_unique<ScrollEvent>(
+          EventType::kScrollFlingStart, pointer_location_, pointer_location_,
+          timestamp, flags, 0, 0, 0, 0, fingers);
+      break;
+    case SwipePhase::kCancel:
+      event = std::make_unique<ScrollEvent>(
+          EventType::kScrollFlingCancel, pointer_location_, pointer_location_,
+          timestamp, flags, 0, 0, 0, 0, fingers);
+      break;
+    case SwipePhase::kBegin:
+      return;
+  }
+  event->set_source_device_id(device_id);
+  SetTargetAndDispatchEvent(event.get(), target);
 }
 
