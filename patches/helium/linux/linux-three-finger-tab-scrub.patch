+// Copyright 2026 The Helide Authors
+// Use of this source code is governed by the GPL-3.0 license in LICENSE.
+
+#include "chrome/browser/ui/views/helium/helium_tab_scrub_glow_view.h"
+
+#include <utility>
+
+#include "cc/paint/paint_flags.h"
+#include "third_party/skia/include/core/SkClipOp.h"
+#include "third_party/skia/include/core/SkColor.h"
+#include "third_party/skia/include/core/SkRRect.h"
+#include "ui/base/metadata/metadata_impl_macros.h"
+#include "ui/color/color_id.h"
+#include "ui/color/color_provider.h"
+#include "ui/compositor/layer.h"
+#include "ui/gfx/canvas.h"
+#include "ui/gfx/geometry/insets_f.h"
+#include "ui/gfx/geometry/skia_conversions.h"
+#include "ui/gfx/geometry/vector2d.h"
+#include "ui/gfx/scoped_canvas.h"
+#include "ui/gfx/shadow_value.h"
+#include "ui/gfx/skia_paint_util.h"
+
+namespace helium {
+
+namespace {
+
+// Blur radius of the halo, in DIPs.
+constexpr int kHaloBlur = 24;
+constexpr float kOutlineWidth = 1.5f;
+
+}  // namespace
+
+TabScrubGlowView::TabScrubGlowView() {
+  // The overlay only draws; the swipe is handled elsewhere.
+  SetCanProcessEventsWithinSubtree(false);
+  SetPaintToLayer();
+  layer()->SetFillsBoundsOpaquely(false);
+}
+
+TabScrubGlowView::~TabScrubGlowView() = default;
+
+void TabScrubGlowView::SetShapes(std::vector<Shape> shapes) {
+  shapes_ = std::move(shapes);
+  SchedulePaint();
+}
+
+void TabScrubGlowView::OnPaint(gfx::Canvas* canvas) {
+  const ui::ColorProvider* provider = GetColorProvider();
+  if (!provider) {
+    return;
+  }
+  const SkColor accent = provider->GetColor(ui::kColorSysPrimary);
+
+  for (const Shape& shape : shapes_) {
+    gfx::ScopedCanvas scoped(canvas);
+    if (shape.clip) {
+      canvas->ClipRect(*shape.clip);
+    }
+
+    const SkRRect outline = SkRRect::MakeRectXY(
+        gfx::RectFToSkRect(shape.bounds), shape.corner_radius,
+        shape.corner_radius);
+
+    // Light spilling out from the edge. The inside is cut away so the halo
+    // never darkens the label underneath.
+    {
+      gfx::ScopedCanvas halo_scope(canvas);
+      canvas->sk_canvas()->clipRRect(outline, SkClipOp::kDifference,
+                                     /*doAntiAlias=*/true);
+      cc::PaintFlags halo_flags;
+      halo_flags.setAntiAlias(true);
+      halo_flags.setColor(SK_ColorTRANSPARENT);
+      halo_flags.setLooper(gfx::CreateShadowDrawLooper(
+          {gfx::ShadowValue(gfx::Vector2d(), kHaloBlur,
+                            SkColorSetA(accent, shape.is_pane ? 0x88 : 0xA0))}));
+      canvas->DrawRoundRect(shape.bounds, shape.corner_radius, halo_flags);
+    }
+
+    // A faint tint inside. Panes cover page content, so theirs is fainter.
+    cc::PaintFlags fill_flags;
+    fill_flags.setAntiAlias(true);
+    fill_flags.setColor(SkColorSetA(accent, shape.is_pane ? 0x0E : 0x2A));
+    canvas->DrawRoundRect(shape.bounds, shape.corner_radius, fill_flags);
+
+    // Crisp edge.
+    cc::PaintFlags edge_flags;
+    edge_flags.setAntiAlias(true);
+    edge_flags.setStyle(cc::PaintFlags::kStroke_Style);
+    edge_flags.setStrokeWidth(kOutlineWidth);
+    edge_flags.setColor(SkColorSetA(accent, 0xE6));
+    gfx::RectF edge = shape.bounds;
+    edge.Inset(kOutlineWidth / 2);
+    canvas->DrawRoundRect(edge, shape.corner_radius, edge_flags);
+  }
+}
+
+BEGIN_METADATA(TabScrubGlowView)
+END_METADATA
+
+}  // namespace helium
