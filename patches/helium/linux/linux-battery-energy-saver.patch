+++ b/base/power_monitor/battery_level_provider_linux.cc
@@ -0,0 +1,185 @@
+// Copyright 2026 The Helium Authors
+// You can use, redistribute, and/or modify this source code under
+// the terms of the GPL-3.0 license that can be found in the LICENSE file.
+
+// Battery state on Linux, read from the kernel's power_supply class in sysfs
+// (/sys/class/power_supply). This lets the BatteryStateSampler, and with it
+// Energy Saver, know that the device has a battery and how full it is.
+
+#include <stdint.h>
+
+#include <optional>
+#include <string>
+#include <string_view>
+#include <vector>
+
+#include "base/files/file_enumerator.h"
+#include "base/files/file_path.h"
+#include "base/files/file_util.h"
+#include "base/functional/bind.h"
+#include "base/functional/callback.h"
+#include "base/location.h"
+#include "base/memory/scoped_refptr.h"
+#include "base/memory/weak_ptr.h"
+#include "base/power_monitor/battery_level_provider.h"
+#include "base/strings/string_number_conversions.h"
+#include "base/strings/string_util.h"
+#include "base/task/sequenced_task_runner.h"
+#include "base/task/task_traits.h"
+#include "base/task/thread_pool.h"
+#include "base/threading/scoped_blocking_call.h"
+
+namespace base {
+
+namespace {
+
+constexpr char kPowerSupplyPath[] = "/sys/class/power_supply";
+
+// sysfs attributes are short; anything longer is not a value we understand.
+constexpr size_t kMaxAttributeSize = 64;
+
+std::optional<std::string> ReadAttribute(const FilePath& supply,
+                                         std::string_view name) {
+  std::string value;
+  if (!ReadFileToStringWithMaxSize(supply.Append(name), &value,
+                                   kMaxAttributeSize)) {
+    return std::nullopt;
+  }
+  return std::string(TrimWhitespaceASCII(value, TRIM_ALL));
+}
+
+std::optional<uint64_t> ReadUint64Attribute(const FilePath& supply,
+                                            std::string_view name) {
+  const std::optional<std::string> value = ReadAttribute(supply, name);
+  uint64_t number = 0;
+  if (!value || !StringToUint64(*value, &number)) {
+    return std::nullopt;
+  }
+  return number;
+}
+
+// Supplies with "Device" scope power a peripheral (a mouse, a headset, a
+// USB-C port's own controller), not the system.
+bool IsSystemSupply(const FilePath& supply) {
+  const std::optional<std::string> scope = ReadAttribute(supply, "scope");
+  return !scope || *scope != "Device";
+}
+
+class BatteryLevelProviderLinux : public BatteryLevelProvider {
+ public:
+  BatteryLevelProviderLinux() = default;
+  ~BatteryLevelProviderLinux() override = default;
+
+  void GetBatteryState(
+      OnceCallback<void(const std::optional<BatteryState>&)> callback)
+      override {
+    // sysfs reads block, so run them off the calling sequence.
+    blocking_task_runner_->PostTaskAndReplyWithResult(
+        FROM_HERE, BindOnce(&BatteryLevelProviderLinux::GetBatteryStateImpl),
+        BindOnce(&BatteryLevelProviderLinux::OnBatteryStateObtained,
+                 weak_ptr_factory_.GetWeakPtr(), std::move(callback)));
+  }
+
+ private:
+  static std::optional<BatteryState> GetBatteryStateImpl() {
+    ScopedBlockingCall scoped_blocking_call(FROM_HERE, BlockingType::MAY_BLOCK);
+
+    std::vector<BatteryDetails> batteries;
+    bool has_external_supply = false;
+    bool external_supply_online = false;
+
+    // The entries are symlinks to the devices' directories; following them
+    // (the default) makes them enumerate as directories.
+    FileEnumerator enumerator(FilePath(kPowerSupplyPath), /*recursive=*/false,
+                              FileEnumerator::DIRECTORIES);
+    for (FilePath supply = enumerator.Next(); !supply.empty();
+         supply = enumerator.Next()) {
+      const std::optional<std::string> type = ReadAttribute(supply, "type");
+      if (!type || !IsSystemSupply(supply)) {
+        continue;
+      }
+
+      if (*type == "Mains" || StartsWith(*type, "USB")) {
+        has_external_supply = true;
+        if (ReadAttribute(supply, "online") == "1") {
+          external_supply_online = true;
+        }
+        continue;
+      }
+
+      if (*type != "Battery" || ReadAttribute(supply, "present") == "0") {
+        continue;
+      }
+
+      BatteryDetails details;
+      // Until an external supply says otherwise, trust the battery's own
+      // status. A battery held at a charge limit reports "Not charging" on
+      // AC, so only "Discharging" means running on it.
+      details.is_external_power_connected =
+          ReadAttribute(supply, "status") != "Discharging";
+
+      // Prefer energy (µWh) over charge (µAh) over a plain percentage.
+      const std::optional<uint64_t> energy_now =
+          ReadUint64Attribute(supply, "energy_now");
+      const std::optional<uint64_t> energy_full =
+          ReadUint64Attribute(supply, "energy_full");
+      const std::optional<uint64_t> charge_now =
+          ReadUint64Attribute(supply, "charge_now");
+      const std::optional<uint64_t> charge_full =
+          ReadUint64Attribute(supply, "charge_full");
+      const std::optional<uint64_t> capacity =
+          ReadUint64Attribute(supply, "capacity");
+      if (energy_now && energy_full && *energy_full > 0) {
+        details.current_capacity = *energy_now / 1000;
+        details.full_charged_capacity = *energy_full / 1000;
+        details.charge_unit = BatteryLevelUnit::kMWh;
+      } else if (charge_now && charge_full && *charge_full > 0) {
+        details.current_capacity = *charge_now / 1000;
+        details.full_charged_capacity = *charge_full / 1000;
+        details.charge_unit = BatteryLevelUnit::kMAh;
+      } else if (capacity) {
+        details.current_capacity = *capacity;
+        details.full_charged_capacity = 100;
+        details.charge_unit = BatteryLevelUnit::kRelative;
+      } else {
+        continue;
+      }
+
+      if (const std::optional<uint64_t> voltage_uv =
+              ReadUint64Attribute(supply, "voltage_now")) {
+        details.voltage_mv = *voltage_uv / 1000;
+      }
+      batteries.push_back(details);
+    }
+
+    // A mains or USB supply is the more direct signal for "plugged in".
+    if (has_external_supply) {
+      for (BatteryDetails& details : batteries) {
+        details.is_external_power_connected = external_supply_online;
+      }
+    }
+
+    return MakeBatteryState(batteries);
+  }
+
+  void OnBatteryStateObtained(
+      OnceCallback<void(const std::optional<BatteryState>&)> callback,
+      const std::optional<BatteryState>& battery_state) {
+    std::move(callback).Run(battery_state);
+  }
+
+  scoped_refptr<SequencedTaskRunner> blocking_task_runner_{
+      ThreadPool::CreateSequencedTaskRunner(
+          {MayBlock(), TaskPriority::BEST_EFFORT,
+           TaskShutdownBehavior::CONTINUE_ON_SHUTDOWN})};
+
+  WeakPtrFactory<BatteryLevelProviderLinux> weak_ptr_factory_{this};
+};
+
+}  // namespace
+
+std::unique_ptr<BatteryLevelProvider> BatteryLevelProvider::Create() {
+  return std::make_unique<BatteryLevelProviderLinux>();
+}
+
+}  // namespace base
