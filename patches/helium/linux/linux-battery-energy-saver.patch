+
+void PowerMonitorDeviceSourceLinux::OnGetOnBattery(
+    dbus_utils::CallMethodResultSig<"v"> result) {
+  if (!result.has_value()) {
+    DLOG(WARNING) << "Failed to get UPower OnBattery property";
+    return;
+  }
+
+  auto [variant] = std::move(*result);
+  std::optional<bool> on_battery = std::move(variant).Take<bool>();
+  if (on_battery.has_value()) {
+    SetOnBattery(*on_battery);
+  }
+}
+
+void PowerMonitorDeviceSourceLinux::OnUPowerPropertiesChanged(
+    dbus_utils::ConnectToSignalResultSig<"sa{sv}as"> result) {
+  if (!result.has_value()) {
+    return;
+  }
+
+  auto [interface_name, changed_properties, invalidated_properties] =
+      std::move(*result);
+  if (interface_name != kUPowerInterface) {
+    return;
+  }
+
+  auto it = changed_properties.find(kUPowerOnBatteryProperty);
+  if (it != changed_properties.end()) {
+    std::optional<bool> on_battery = std::move(it->second).Take<bool>();
+    if (on_battery.has_value()) {
+      SetOnBattery(*on_battery);
+    }
+  }
+}
+
+void PowerMonitorDeviceSourceLinux::SetOnBattery(bool on_battery) {
+  if (on_battery_ == on_battery) {
+    return;
+  }
+  on_battery_ = on_battery;
+  ProcessPowerEvent(POWER_STATE_EVENT);
+}
