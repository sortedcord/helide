+
+// Below this width (a collapsed strip) the address bar becomes an icon and the
+// toolbar shows only the app menu.
+constexpr int kCompactWidth = 120;
+
+// How long the address bar stays after the window is activated, so that the
+// click which activated the window still lands on what the user clicked,
+// instead of on whatever moves up into its place.
+constexpr base::TimeDelta kAutohideDelay = base::Milliseconds(350);
+
+constexpr int kCompactIconSize = 16;
+
+// How long the address bar takes to slide in or out with autohide.
+constexpr base::TimeDelta kRevealDuration = base::Milliseconds(200);
+
+}  // namespace
+
+// The top of the strip: the address bar, or an icon for it when the strip is
+// too narrow. With autohide it slides in and out: its height grows from zero,
+// pushing the tabs down, while the address bar slides down from above and
+// fades in.
+class SynergyTopRow : public views::View, public gfx::AnimationDelegate {
+  METADATA_HEADER(SynergyTopRow, views::View)
+
+ public:
+  SynergyTopRow(SynergyController* controller, const gfx::Insets& padding) {
+    SetBorder(views::CreateEmptyBorder(padding));
+    SetPaintToLayer();
+    layer()->SetFillsBoundsOpaquely(false);
+    layer()->SetMasksToBounds(true);
+
+    icon_ = AddChildView(views::CreateVectorImageButtonWithNativeTheme(
+        base::BindRepeating(&SynergyController::FocusAddressBar,
+                            base::Unretained(controller)),
+        vector_icons::kSearchIcon, kCompactIconSize, kColorToolbarButtonIcon));
+    icon_->SetTooltipText(u"Address bar");
+    icon_->GetViewAccessibility().SetName(u"Address bar");
+    icon_->SetVisible(false);
+
+    reveal_.SetSlideDuration(kRevealDuration);
+    reveal_.SetTweenType(gfx::Tween::EASE_OUT);
+    reveal_.Reset(1.0);
+  }
+  SynergyTopRow(const SynergyTopRow&) = delete;
+  SynergyTopRow& operator=(const SynergyTopRow&) = delete;
+  ~SynergyTopRow() override = default;
+
+  void SetLocationBar(views::View* location_bar) {
+    location_bar_ = location_bar;
+    PreferredSizeChanged();
+  }
+
+  // Whether the address bar is shown, or on its way in.
+  bool shown() const { return reveal_.IsShowing(); }
+
+  void SetShown(bool shown, bool animate) {
+    if (!location_bar_ || (shown == reveal_.IsShowing() &&
+                           (animate || !reveal_.is_animating()))) {
+      return;
+    }
+    if (shown) {
+      // Visible from the start, so that it can take focus right away.
+      location_bar_->SetVisible(true);
+    }
+    if (!animate) {
+      reveal_.Reset(shown ? 1.0 : 0.0);
+      AnimationProgressed(&reveal_);
+      AnimationEnded(&reveal_);
+      return;
+    }
+    if (shown) {
+      reveal_.Show();
+    } else {
+      reveal_.Hide();
+    }
+  }
+
+  // views::View:
+  gfx::Size CalculatePreferredSize(
+      const views::SizeBounds& available_size) const override {
+    if (!location_bar_ || !location_bar_->GetVisible()) {
+      return gfx::Size();
+    }
+    const int full =
+        location_bar_->GetPreferredSize().height() + GetInsets().height();
+    // At least a pixel while it shows: the strip's layout hides empty rows,
+    // and the address bar could not take focus in a hidden row.
+    return gfx::Size(0, std::max(1, gfx::Tween::IntValueBetween(
+                                        reveal_.GetCurrentValue(), 0, full)));
+  }
+
+  void Layout(PassKey) override {
+    const bool compact = width() < kCompactWidth;
+    const bool bar_visible = location_bar_ && location_bar_->GetVisible();
+    icon_->SetVisible(compact && bar_visible);
+
+    // The contents keep their full height and slide down into the row as it
+    // grows.
+    gfx::Rect contents = GetContentsBounds();
+    if (location_bar_) {
+      const int full = location_bar_->GetPreferredSize().height();
+      contents.set_y(height() - GetInsets().bottom() - full);
+      contents.set_height(full);
+      // The address bar stays visible while it is an icon, so that Ctrl+L
+      // still focuses it; focus then expands the strip.
+      location_bar_->SetBoundsRect(compact ? gfx::Rect() : contents);
+    }
+    const gfx::Size icon_size = icon_->GetPreferredSize();
+    icon_->SetBoundsRect(
+        gfx::Rect(contents.x() + (contents.width() - icon_size.width()) / 2,
+                  contents.y() + (contents.height() - icon_size.height()) / 2,
+                  icon_size.width(), icon_size.height()));
+  }
+
+  // gfx::AnimationDelegate:
+  void AnimationProgressed(const gfx::Animation* animation) override {
+    layer()->SetOpacity(static_cast<float>(reveal_.GetCurrentValue()));
+    PreferredSizeChanged();
+  }
+  void AnimationEnded(const gfx::Animation* animation) override {
+    if (location_bar_ && !reveal_.IsShowing()) {
+      location_bar_->SetVisible(false);
+    }
+    PreferredSizeChanged();
+  }
+
+ protected:
+  void ChildPreferredSizeChanged(views::View* child) override {
+    if (child == location_bar_) {
+      PreferredSizeChanged();
+    }
+  }
+  void ChildVisibilityChanged(views::View* child) override {
+    if (child == location_bar_) {
+      PreferredSizeChanged();
+    }
+  }
+
+ private:
+  raw_ptr<views::View> location_bar_ = nullptr;
+  raw_ptr<views::ImageButton> icon_ = nullptr;
+  gfx::SlideAnimation reveal_{this};
+};
+
+BEGIN_METADATA(SynergyTopRow)
+END_METADATA
+
+// The bottom of the strip: the toolbar.
+class SynergyBottomRow : public views::View {
+  METADATA_HEADER(SynergyBottomRow, views::View)
+
+ public:
+  explicit SynergyBottomRow(SynergyController* controller)
+      : controller_(controller) {}
+  SynergyBottomRow(const SynergyBottomRow&) = delete;
+  SynergyBottomRow& operator=(const SynergyBottomRow&) = delete;
+  ~SynergyBottomRow() override = default;
+
+  void SetToolbar(views::View* toolbar) {
+    toolbar_ = toolbar;
+    PreferredSizeChanged();
+  }
+
+  // views::View:
+  gfx::Size CalculatePreferredSize(
+      const views::SizeBounds& available_size) const override {
+    if (!toolbar_ || !toolbar_->GetVisible()) {
+      return gfx::Size();
+    }
+    return gfx::Size(0, toolbar_->GetPreferredSize().height() +
+                            GetInsets().height());
+  }
+
+  void Layout(PassKey) override {
+    const bool compact = width() < kCompactWidth;
+    if (toolbar_) {
+      // A collapsed strip is narrower than the toolbar's margins around the
+      // one button it keeps; let the margins hang over the edges.
+      gfx::Rect bounds = GetContentsBounds();
+      if (compact_) {
+        const int needed = toolbar_->GetPreferredSize().width();
+        if (needed > bounds.width()) {
+          bounds.Inset(gfx::Insets::VH(0, -(needed - bounds.width()) / 2));
+        }
+      }
+      toolbar_->SetBoundsRect(bounds);
+    }
+    if (width() == 0) {
+      return;
+    }
+    if (compact != compact_) {
+      compact_ = compact;
+      // Changing which buttons show relays out the toolbar; not from here.
+      base::SequencedTaskRunner::GetCurrentDefault()->PostTask(
+          FROM_HERE, base::BindOnce(&SynergyBottomRow::NotifyCompactChanged,
+                                    weak_factory_.GetWeakPtr()));
+    }
+  }
+
+ protected:
+  void ChildPreferredSizeChanged(views::View* child) override {
+    if (child == toolbar_) {
+      PreferredSizeChanged();
+    }
+  }
+  void ChildVisibilityChanged(views::View* child) override {
+    if (child == toolbar_) {
+      PreferredSizeChanged();
+    }
+  }
+
+ private:
+  void NotifyCompactChanged() { controller_->OnToolbarCompactChanged(compact_); }
+
+  const raw_ptr<SynergyController> controller_;
+  raw_ptr<views::View> toolbar_ = nullptr;
+  bool compact_ = false;
+  base::WeakPtrFactory<SynergyBottomRow> weak_factory_{this};
+};
