+// One browser window's state, followed for the socket.
+class WindowSource : public AddressBarIpcRegistration,
+                     public TabStripModelObserver,
+                     public content::WebContentsObserver,
+                     public AutocompleteController::Observer,
+                     public views::WidgetObserver {
+ public:
+  explicit WindowSource(BrowserView* browser_view);
+  WindowSource(const WindowSource&) = delete;
+  WindowSource& operator=(const WindowSource&) = delete;
+  ~WindowSource() override;
+
+  int id() const { return id_; }
+  bool focused() const { return widget_ && widget_->IsActive(); }
+  BrowserWindowInterface* browser() const { return browser_; }
+  Profile* profile() const { return browser_->GetProfile(); }
+  content::WebContents* contents() const {
+    return browser_->GetTabStripModel()->GetActiveWebContents();
+  }
+
+  base::DictValue State() const {
+    base::DictValue state;
+    state.Set("event", "state");
+    state.Set("window", id_);
+    state.Set("focused", focused());
+    content::WebContents* const web_contents = contents();
+    if (!web_contents) {
+      return state;
+    }
+    const bool loading = web_contents->IsLoading();
+    state.Set("url", web_contents->GetVisibleURL().possibly_invalid_spec());
+    state.Set("title", base::UTF16ToUTF8(web_contents->GetTitle()));
+    state.Set("loading", loading);
+    state.Set("progress", loading ? progress_ : 1.0);
+    state.Set("can_go_back", web_contents->GetController().CanGoBack());
+    state.Set("can_go_forward", web_contents->GetController().CanGoForward());
+    return state;
+  }
+
+ private:
+  void ObserveActiveTab() {
+    Observe(contents());
+    progress_ = contents() && contents()->IsLoading()
+                    ? contents()->GetLoadProgress()
+                    : 1.0;
+  }
+  void Changed();
+
+  // TabStripModelObserver:
+  void OnTabStripModelChanged(TabStripModel* tab_strip_model,
+                              const TabStripModelChange& change,
+                              const TabStripSelectionChange& selection) override {
+    if (selection.active_tab_changed()) {
+      ObserveActiveTab();
+      Changed();
+    }
+  }
+
+  // content::WebContentsObserver:
+  // The fraction only grows during a load, as the loading bar does; the
+  // contents report a passing 0 as a new document commits.
+  void DidStartLoading() override {
+    progress_ = web_contents()->GetLoadProgress();
+    Changed();
+  }
+  void DidStopLoading() override {
+    progress_ = 1.0;
+    Changed();
+  }
+  void LoadProgressChanged(double progress) override {
+    progress_ = std::max(progress_, progress);
+    Changed();
+  }
+  void TitleWasSet(content::NavigationEntry* entry) override { Changed(); }
+  void DidStartNavigation(content::NavigationHandle* handle) override {
+    if (handle->IsInPrimaryMainFrame()) {
+      Changed();
+    }
+  }
+  void DidFinishNavigation(content::NavigationHandle* handle) override {
+    if (handle->IsInPrimaryMainFrame()) {
+      Changed();
+    }
+  }
+  void WebContentsDestroyed() override { Observe(nullptr); }
+
+  // AutocompleteController::Observer: what is typed in this window's address
+  // bar, and its suggestions.
+  void OnResultChanged(AutocompleteController* controller,
+                       bool default_match_changed) override;
+  void OnControllerDestroying(AutocompleteController* controller) override {
+    autocomplete_observation_.Reset();
+  }
+
+  // views::WidgetObserver:
+  void OnWidgetActivationChanged(views::Widget* widget, bool active) override {
+    Changed();
+  }
+  void OnWidgetDestroying(views::Widget* widget) override {
+    widget_observation_.Reset();
+    widget_ = nullptr;
+  }
+
+  const raw_ptr<BrowserWindowInterface> browser_;
+  const int id_;
+  double progress_ = 1.0;
+  raw_ptr<views::Widget> widget_;
+  base::ScopedObservation<AutocompleteController,
+                          AutocompleteController::Observer>
+      autocomplete_observation_{this};
+  base::ScopedObservation<views::Widget, views::WidgetObserver>
+      widget_observation_{this};
+};
