+DEFINE_USER_DATA(SynergyController);
+
+// static
+void SynergyController::MaybeCreateForBrowserView(BrowserView* browser_view) {
+  if (!browser_view->GetIsNormalType() || !browser_view->GetWidget() ||
+      !browser_view->toolbar() || From(browser_view->browser())) {
+    return;
+  }
+  // Owned by itself; see OnWidgetDestroying().
+  new SynergyController(browser_view);
+}
+
+// static
+SynergyController* SynergyController::From(BrowserWindowInterface* browser) {
+  return Get(browser->GetUnownedUserDataHost());
+}
+
+SynergyController::SynergyController(BrowserView* browser_view)
+    : browser_view_(browser_view), widget_(browser_view->GetWidget()) {
+  BrowserWindowInterface* const browser = browser_view_->browser();
+  scoped_unowned_user_data_.emplace(browser->GetUnownedUserDataHost(), *this);
+
+  pref_change_registrar_.Init(browser_view_->GetProfile()->GetPrefs());
+  pref_change_registrar_.AddMultiple(
+      {kSynergyMode, kSynergyAutohideAddressBar},
+      base::BindRepeating(&SynergyController::ScheduleUpdate,
+                          base::Unretained(this)));
+
+  if (auto* layout_controller = HeliumLayoutStateController::From(browser)) {
+    layout_subscription_ = layout_controller->RegisterOnStateChanged(
+        base::IgnoreArgs<HeliumLayoutStateController*>(base::BindRepeating(
+            &SynergyController::ScheduleUpdate, base::Unretained(this))));
+  }
+  if (auto* vertical = tabs::VerticalTabStripStateController::From(browser)) {
+    vertical_mode_subscription_ = vertical->RegisterOnModeChanged(
+        base::IgnoreArgs<tabs::VerticalTabStripStateController*>(
+            base::BindRepeating(&SynergyController::ScheduleUpdate,
+                                base::Unretained(this))));
+  }
+
+  widget_observation_.Observe(widget_);
+  paint_as_active_subscription_ =
+      widget_->RegisterPaintAsActiveChangedCallback(
+          base::BindRepeating(&SynergyController::OnPaintAsActiveChanged,
+                              base::Unretained(this)));
+  click_monitor_ = views::EventMonitor::CreateWindowMonitor(
+      this, widget_->GetNativeWindow(),
+      {ui::EventType::kMousePressed, ui::EventType::kGestureTap});
+  focus_manager_ = widget_->GetFocusManager();
+  if (focus_manager_) {
+    focus_manager_->AddFocusChangeListener(this);
+  }
+
+  ScheduleUpdate();
+}
+
+SynergyController::~SynergyController() = default;
+
+bool SynergyController::ToggleAddressBarReveal() {
+  if (!active_ || !AutohideEnabled() || !location_bar()) {
+    return false;
+  }
+
+  const bool shown_while_focused =
+      widget_->ShouldPaintAsActive() &&
+      (revealed_ || autohide_delay_timer_.IsRunning());
+  if (shown_while_focused) {
+    revealed_ = false;
+    autohide_delay_timer_.Stop();
+    if (FocusIsInAddressBar()) {
+      if (views::WebView* contents = browser_view_->GetActiveContentsWebView()) {
+        contents->RequestFocus();
+      }
+    }
+    UpdateAddressBarVisibility();
+    return true;
+  }
+
+  revealed_ = true;
+  autohide_delay_timer_.Stop();
+  UpdateAddressBarVisibility();
+  // The row holding the address bar is hidden by the strip's layout while it
+  // is empty; lay out now so that the address bar can take focus.
+  widget_->LayoutRootViewIfNecessary();
+  FocusAddressBar();
+  return true;
+}
+
+void SynergyController::FocusAddressBar() {
+  browser_view_->SetFocusToLocationBar(/*is_user_initiated=*/true);
+  VLOG(1) << "Synergy: focus address bar, focused=" << FocusIsInAddressBar()
+          << " drawn=" << (location_bar() && location_bar()->IsDrawn());
+}
+
+void SynergyController::OnToolbarCompactChanged(bool compact) {
+  if (toolbar_compact_ == compact) {
+    return;
+  }
+  toolbar_compact_ = compact;
+  UpdateToolbarButtons();
+}
+
+void SynergyController::OnWidgetDestroying(views::Widget* widget) {
+  Teardown();
+  delete this;
+}
+
+void SynergyController::OnViewVisibilityChanged(views::View* observed_view,
+                                                views::View* starting_view,
+                                                bool visible) {
+  if (changing_visibility_ || observed_view != starting_view) {
+    return;
+  }
+  auto it = hidden_.find(observed_view);
+  if (it == hidden_.end()) {
+    return;
+  }
+  // Something else changed a button Synergy mode hides. Remember what it
+  // wanted, for when the mode ends, and hide the button again.
+  it->second = visible;
+  if (visible) {
+    ScheduleUpdate();
+  }
+}
+
+void SynergyController::OnChildViewAdded(views::View* observed_view,
+                                         views::View* child) {
+  if (observed_view == toolbar()) {
+    ScheduleUpdate();
+  }
+}
+
+void SynergyController::OnViewIsDeleting(views::View* observed_view) {
+  if (toolbar_observation_.IsObservingSource(observed_view)) {
+    toolbar_observation_.Reset();
+  }
+  if (hidden_observations_.IsObservingSource(observed_view)) {
+    hidden_observations_.RemoveObservation(observed_view);
+    hidden_.erase(observed_view);
+  }
+}
+
+void SynergyController::OnDidChangeFocus(views::View* focused_before,
+                                         views::View* focused_now) {
+  VLOG(1) << "Synergy: focus "
+          << (focused_before ? focused_before->GetClassName() : "null") << " -> "
+          << (focused_now ? focused_now->GetClassName() : "null");
+  // Focus becomes null when the window, or the address bar's own popup, is
+  // activated. That is not leaving the address bar.
+  if (!active_ || !focused_now || !location_bar()) {
+    return;
+  }
+  if (location_bar()->Contains(focused_now)) {
+    if (!expand_lock_ && region()) {
+      expand_lock_ =
+          region()->GetExpandOnHoverLock(ExpandOnHoverLockType::kKeepExpanded);
+    }
+    return;
+  }
+  expand_lock_.reset();
+  if (revealed_) {
+    revealed_ = false;
+    UpdateAddressBarVisibility();
+  }
+}
+
+void SynergyController::ScheduleUpdate() {
+  if (update_pending_) {
+    return;
+  }
+  update_pending_ = true;
+  // Prefs and layout state change in the middle of other updates and layouts;
+  // moving views around is done afterwards.
+  base::SequencedTaskRunner::GetCurrentDefault()->PostTask(
+      FROM_HERE, base::BindOnce(&SynergyController::Update,
+                                weak_factory_.GetWeakPtr()));
+}
+
+void SynergyController::Update() {
+  update_pending_ = false;
+  if (!browser_view_) {
+    return;
+  }
+  VLOG(1) << "Synergy: update, active=" << active_;
+
+  const bool should_be_active = ShouldBeActive();
+  if (should_be_active != active_) {
+    if (should_be_active) {
+      Activate();
+    } else {
+      Deactivate();
+    }
+  }
+  UpdateAddressBarVisibility();
+  UpdateToolbarButtons();
+
+  // The address bar socket comes with Synergy mode.
+  const bool ipc = browser_view_->GetProfile()->GetPrefs()->GetBoolean(
+      kSynergyMode);
+  if (ipc && !ipc_registration_) {
+    ipc_registration_ = RegisterWindowForAddressBarIpc(browser_view_);
+  } else if (!ipc) {
+    ipc_registration_.reset();
+  }
+
+  // Ctrl+Shift+L pins the top chrome in Zen mode, and reveals the address bar
+  // with Synergy autohide.
+  chrome::BrowserCommandController::From(browser_view_->browser())
+      ->UpdateCommandEnabled(
+          IDC_TOGGLE_ZEN_MODE_TOP_CHROME_PIN,
+          browser_view_->IsZenModeEnabledForLayout() ||
+              (active_ && AutohideEnabled()));
+}
+
+bool SynergyController::ShouldBeActive() const {
+  BrowserWindowInterface* const browser = browser_view_->browser();
+  const auto* vertical = tabs::VerticalTabStripStateController::From(browser);
+  VerticalTabStripRegionView* const strip = region();
+  return browser_view_->GetProfile()->GetPrefs()->GetBoolean(kSynergyMode) &&
+         vertical && vertical->ShouldDisplayVerticalTabs() &&
+         browser_view_->GetSupportsTabStrip() &&
+         !browser_view_->IsZenModeEnabledForLayout() && toolbar() &&
+         location_bar() && strip && strip->GetBottomContainer();
+}
+
+bool SynergyController::AutohideEnabled() const {
+  return browser_view_->GetProfile()->GetPrefs()->GetBoolean(
+      kSynergyAutohideAddressBar);
+}
+
+void SynergyController::Activate() {
+  ToolbarView* const toolbar_view = toolbar();
+  LocationBarView* const location_bar_view = location_bar();
+  views::View* const top_container = browser_view_->top_container();
+  views::View* const content =
+      region()->GetBottomContainer() ? region()->GetBottomContainer()->parent()
+                                     : nullptr;
+  if (!content || location_bar_view->parent() != toolbar_view ||
+      toolbar_view->parent() != top_container) {
+    return;
+  }
+
+  location_bar_index_ = toolbar_view->GetIndexOf(location_bar_view).value();
+  toolbar_index_ = top_container->GetIndexOf(toolbar_view).value();
+
+  leading_views_.clear();
+  for (size_t i = 0; i < location_bar_index_; ++i) {
+    leading_views_.push_back(
+        std::make_unique<views::ViewTracker>(toolbar_view->children()[i]));
+  }
+
+  const int padding =
+      GetLayoutConstant(LayoutConstant::kVerticalTabStripHorizontalPadding);
+
+  // The padding is inside the row, so that it goes away with the address bar.
+  top_row_ = content->AddChildViewAt(
+      std::make_unique<SynergyTopRow>(
+          this, gfx::Insets::TLBR(padding, padding, 0, padding)),
+      0);
+  top_row_->AddChildView(location_bar_view);
+  top_row_->SetLocationBar(location_bar_view);
+
+  auto bottom_row = std::make_unique<SynergyBottomRow>(this);
+  // Room below the buttons for the outline around the extension icons.
+  bottom_row->SetBorder(
+      views::CreateEmptyBorder(gfx::Insets::TLBR(0, 0, padding / 2, 0)));
+  bottom_row_ = content->AddChildView(std::move(bottom_row));
+  bottom_row_->AddChildView(toolbar_view);
+  bottom_row_->SetToolbar(toolbar_view);
+
+  // The strip's background shows through.
+  if (auto* background =
+          static_cast<CustomCornersBackground*>(toolbar_view->background())) {
+    background->SetVisible(false);
+  }
+  toolbar_observation_.Observe(toolbar_view);
+
+  active_ = true;
+  toolbar_compact_ = false;
+  // The security chip drops its text in the strip; see LocationIconView.
+  location_bar_view->location_icon_view()->Update(
+        /*suppress_animations=*/true, /*force_hide_background=*/false);
+  content->InvalidateLayout();
+  browser_view_->InvalidateLayout();
+}
+
+void SynergyController::Deactivate() {
+  if (!active_) {
+    return;
+  }
+  active_ = false;
+  revealed_ = false;
+  autohide_delay_timer_.Stop();
+  expand_lock_.reset();
+
+  // Puts the hidden toolbar buttons back.
+  UpdateToolbarButtons();
+  leading_views_.clear();
+  toolbar_observation_.Reset();
+
+  ToolbarView* const toolbar_view = toolbar();
+  LocationBarView* const location_bar_view = location_bar();
+  views::View* const top_container = browser_view_->top_container();
+  if (toolbar_view) {
+    if (auto* background = static_cast<CustomCornersBackground*>(
+            toolbar_view->background())) {
+      background->SetVisible(true);
+    }
+    top_container->AddChildViewAt(
+        toolbar_view,
+        std::min(toolbar_index_, top_container->children().size()));
+  }
+  if (toolbar_view && location_bar_view) {
+    location_bar_view->SetVisible(true);
+    toolbar_view->AddChildViewAt(
+        location_bar_view,
+        std::min(location_bar_index_, toolbar_view->children().size()));
+    location_bar_view->location_icon_view()->Update(
+        /*suppress_animations=*/true, /*force_hide_background=*/false);
+  }
+
+  // The rows are empty now; remove them.
+  if (top_row_) {
+    views::View* const parent = top_row_->parent();
+    SynergyTopRow* const row = top_row_;
+    row->SetLocationBar(nullptr);
+    top_row_ = nullptr;
+    parent->RemoveChildViewT(row);
+    parent->InvalidateLayout();
+  }
+  if (bottom_row_) {
+    views::View* const parent = bottom_row_->parent();
+    SynergyBottomRow* const row = bottom_row_;
+    bottom_row_ = nullptr;
+    parent->RemoveChildViewT(row);
+  }
+
+  if (toolbar_view) {
+    toolbar_view->InvalidateLayout();
+  }
+  browser_view_->InvalidateLayout();
+}
+
+void SynergyController::UpdateAddressBarVisibility() {
+  LocationBarView* const location_bar_view = location_bar();
+  if (!active_ || !location_bar_view) {
+    return;
+  }
+  const bool hide = AutohideEnabled() && widget_->ShouldPaintAsActive() &&
+                    !revealed_ && !autohide_delay_timer_.IsRunning();
+  if (!top_row_ || top_row_->shown() == !hide) {
+    return;
+  }
+  if (hide && FocusIsInAddressBar()) {
+    // Hiding a focused view would pass focus to the next view in the strip.
+    if (views::WebView* contents = browser_view_->GetActiveContentsWebView()) {
+      contents->RequestFocus();
+    }
+  }
+  top_row_->SetShown(!hide, /*animate=*/true);
+}
+
+void SynergyController::UpdateToolbarButtons() {
+  std::set<views::View*> should_hide;
+  ToolbarView* const toolbar_view = toolbar();
+  if (active_ && toolbar_view) {
+    for (const auto& tracker : leading_views_) {
+      if (tracker->view() && tracker->view()->parent() == toolbar_view) {
+        should_hide.insert(tracker->view());
+      }
+    }
+    for (views::View* child : toolbar_view->children()) {
+      const ui::ElementIdentifier id =
+          child->GetProperty(views::kElementIdentifierKey);
+      // The collapse button lives right of the menu with a right-aligned strip.
+      // The overflow button belongs to the toolbar's own layout.
+      if (id == kToolbarOverflowButtonElementId) {
+        continue;
+      }
+      if (id == kToolbarVerticalTabsCollapseButtonElementId ||
+          id == kToolbarDynamicNewTabButtonElementId ||
+          (toolbar_compact_ && id != kToolbarAppMenuButtonElementId)) {
+        should_hide.insert(child);
+      }
+    }
+  }
+
+  std::vector<views::View*> to_show;
+  for (const auto& [view, wanted] : hidden_) {
+    if (!should_hide.contains(view)) {
+      to_show.push_back(view);
+    }
+  }
+  for (views::View* view : to_show) {
+    SetHidden(view, false);
+  }
+  for (views::View* view : should_hide) {
+    SetHidden(view, true);
+  }
+}
+
+void SynergyController::SetHidden(views::View* view, bool hidden) {
+  base::AutoReset<bool> changing(&changing_visibility_, true);
+  auto it = hidden_.find(view);
+  if (!hidden) {
+    if (it == hidden_.end()) {
+      return;
+    }
+    const bool wanted = it->second;
+    hidden_.erase(it);
+    hidden_observations_.RemoveObservation(view);
+    view->SetVisible(wanted);
+    return;
+  }
+  if (it == hidden_.end()) {
+    hidden_.emplace(view, view->GetVisible());
+    hidden_observations_.AddObservation(view);
+  }
+  if (view->GetVisible()) {
+    view->SetVisible(false);
+  }
+}
+
+void SynergyController::OnPaintAsActiveChanged() {
+  if (!active_) {
+    return;
+  }
+  if (widget_->ShouldPaintAsActive()) {
+    if (AutohideEnabled() && location_bar() && location_bar()->GetVisible()) {
+      autohide_delay_timer_.Start(
+          FROM_HERE, kAutohideDelay,
+          base::BindOnce(&SynergyController::OnAutohideDelayElapsed,
+                         base::Unretained(this)));
+    }
+  } else {
+    autohide_delay_timer_.Stop();
+  }
+  UpdateAddressBarVisibility();
+}
+
+void SynergyController::OnAutohideDelayElapsed() {
+  UpdateAddressBarVisibility();
+}
+
+void SynergyController::OnEvent(const ui::Event& event) {
+  // A click on the address bar while it shows (as when it activates the
+  // window) keeps it until focus leaves it.
+  LocationBarView* const location_bar_view = location_bar();
+  if (!active_ || !event.IsLocatedEvent() || !location_bar_view ||
+      !location_bar_view->IsDrawn()) {
+    return;
+  }
+  const gfx::Point point = event.AsLocatedEvent()->root_location();
+  gfx::Point in_bar = point;
+  views::View::ConvertPointFromWidget(location_bar_view, &in_bar);
+  if (location_bar_view->HitTestPoint(in_bar)) {
+    revealed_ = true;
+  }
+}
+
+bool SynergyController::FocusIsInAddressBar() const {
+  const views::View* const focused =
+      focus_manager_ ? focus_manager_->GetFocusedView() : nullptr;
+  return focused && location_bar() && location_bar()->Contains(focused);
+}
+
+void SynergyController::Teardown() {
+  weak_factory_.InvalidateWeakPtrs();
+  update_pending_ = false;
+  ipc_registration_.reset();
+  // Put the views back where the rest of the browser view expects them while
+  // it is still whole.
+  Deactivate();
+  hidden_observations_.RemoveAllObservations();
+  hidden_.clear();
+  if (focus_manager_) {
+    focus_manager_->RemoveFocusChangeListener(this);
+    focus_manager_ = nullptr;
+  }
+  click_monitor_.reset();
+  paint_as_active_subscription_ = {};
+  layout_subscription_ = {};
+  vertical_mode_subscription_ = {};
+  pref_change_registrar_.RemoveAll();
+  widget_observation_.Reset();
+  scoped_unowned_user_data_.reset();
+  browser_view_ = nullptr;
+  widget_ = nullptr;
+}
+
+VerticalTabStripRegionView* SynergyController::region() const {
+  return browser_view_ ? browser_view_->vertical_tab_strip_region_view_for_testing()
+                       : nullptr;
+}
+
+ToolbarView* SynergyController::toolbar() const {
+  return browser_view_ ? browser_view_->toolbar() : nullptr;
+}
+
+LocationBarView* SynergyController::location_bar() const {
+  return browser_view_ ? browser_view_->GetLocationBarView() : nullptr;
+}
+
