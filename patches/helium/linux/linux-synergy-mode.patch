+std::unique_ptr<AddressBarIpcRegistration> RegisterWindowForAddressBarIpc(
+    BrowserView* browser_view) {
+  if (!browser_view->GetProfile() ||
+      browser_view->GetProfile()->IsOffTheRecord()) {
+    return nullptr;
+  }
+  return std::make_unique<WindowSource>(browser_view);
+}
