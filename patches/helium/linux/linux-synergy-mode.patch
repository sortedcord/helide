+std::optional<base::FilePath> SocketPath() {
+  std::unique_ptr<base::Environment> env = base::Environment::Create();
+  std::optional<std::string> runtime_dir = env->GetVar("XDG_RUNTIME_DIR");
+  if (!runtime_dir || runtime_dir->empty()) {
+    return std::nullopt;
+  }
+  return base::FilePath(*runtime_dir).Append(kSocketName);
