+// A suggestion query from a client, answered without the browser's UI.
+class Query : public AutocompleteController::Observer {
+ public:
+  using ResultCallback = base::RepeatingCallback<void(
+      const Query& query,
+      const AutocompleteController& controller)>;
+
+  Query(Profile* profile,
+        int client,
+        base::Value request_id,
+        int window,
+        const std::string& text,
+        ResultCallback on_result)
+      : client_(client),
+        request_id_(std::move(request_id)),
+        window_(window),
+        input_(text),
+        on_result_(std::move(on_result)) {
+    controller_ = std::make_unique<AutocompleteController>(
+        std::make_unique<ChromeAutocompleteProviderClient>(profile),
+        AutocompleteControllerConfig{
+            .provider_types = AutocompleteClassifier::DefaultOmniboxProviders()});
+    controller_->AddObserver(this);
+    controller_->Start(AutocompleteInput(
+        base::UTF8ToUTF16(text), metrics::OmniboxEventProto::OTHER,
+        ChromeAutocompleteSchemeClassifier(profile)));
+  }
+  Query(const Query&) = delete;
+  Query& operator=(const Query&) = delete;
+  ~Query() override { controller_->RemoveObserver(this); }
+
+  int client() const { return client_; }
+  const base::Value& request_id() const { return request_id_; }
+  int window() const { return window_; }
+  const std::string& input() const { return input_; }
+
+ private:
+  // AutocompleteController::Observer:
+  void OnResultChanged(AutocompleteController* controller,
+                       bool default_match_changed) override {
+    on_result_.Run(*this, *controller);
+  }
+
+  const int client_;
+  const base::Value request_id_;
+  const int window_;
+  const std::string input_;
+  const ResultCallback on_result_;
+  std::unique_ptr<AutocompleteController> controller_;
+};
