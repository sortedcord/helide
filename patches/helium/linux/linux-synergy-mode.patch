+// ---------------------------------------------------------------------------
+// The protocol, on the UI thread. One instance while windows are registered.
+class Server {
+ public:
+  static Server* instance() { return instance_; }
+
+  static void AddWindow(WindowSource* window) {
+    if (!instance_) {
+      std::optional<base::FilePath> path = SocketPath();
+      if (!path) {
+        return;
+      }
+      instance_ = new Server(*path);
+    }
+    instance_->windows_.push_back(window);
+    instance_->BroadcastState(*window);
+  }
+
+  static void RemoveWindow(WindowSource* window) {
+    if (!instance_) {
+      return;
+    }
+    Server* const server = instance_;
+    std::erase(server->windows_, window);
+    std::erase_if(server->queries_, [&](const auto& entry) {
+      return entry.second->window() == window->id();
+    });
+    server->Broadcast(base::DictValue()
+                          .Set("event", "closed")
+                          .Set("window", window->id()));
+    if (server->windows_.empty()) {
+      instance_ = nullptr;
+      delete server;
+    }
+  }
+
+  void BroadcastState(const WindowSource& window) {
+    Broadcast(window.State());
+  }
+
+  void BroadcastAddressBarSuggestions(const WindowSource& window,
+                                      const AutocompleteController& controller) {
+    Broadcast(base::DictValue()
+                  .Set("event", "suggestions")
+                  .Set("source", "address_bar")
+                  .Set("window", window.id())
+                  .Set("input", base::UTF16ToUTF8(controller.input().text()))
+                  .Set("done", controller.done())
+                  .Set("suggestions", SuggestionsToList(controller.result())));
+  }
+
+ private:
+  explicit Server(const base::FilePath& path)
+      : io_(base::ThreadPool::CreateSequencedTaskRunner(
+                {base::MayBlock(), base::TaskPriority::USER_VISIBLE,
+                 base::TaskShutdownBehavior::SKIP_ON_SHUTDOWN}),
+            path,
+            base::BindPostTaskToCurrentDefault(base::BindRepeating(
+                &Server::OnLine, weak_factory_.GetWeakPtr())),
+            base::BindPostTaskToCurrentDefault(base::BindRepeating(
+                &Server::OnClosed, weak_factory_.GetWeakPtr()))) {}
+  ~Server() = default;
+
+  void Send(int client, base::DictValue message) {
+    if (std::optional<std::string> json = base::WriteJson(message)) {
+      io_.AsyncCall(&SocketIo::Send).WithArgs(client, std::move(*json));
+    }
+  }
+
+  void Broadcast(base::DictValue message) {
+    if (subscribers_.empty()) {
+      return;
+    }
+    if (std::optional<std::string> json = base::WriteJson(message)) {
+      io_.AsyncCall(&SocketIo::Broadcast)
+          .WithArgs(std::vector<int>(subscribers_.begin(), subscribers_.end()),
+                    std::move(*json));
+    }
+  }
+
+  void Reply(int client, const base::Value* id, base::DictValue message) {
+    if (id) {
+      message.Set("id", id->Clone());
+    }
+    Send(client, std::move(message));
+  }
+
+  void Error(int client, const base::Value* id, std::string_view error) {
+    Reply(client, id, base::DictValue().Set("ok", false).Set("error", error));
+  }
+
+  // The window a request names, or the focused (else the first) window.
+  WindowSource* FindWindow(const base::DictValue& request) {
+    if (std::optional<int> id = request.FindInt("window")) {
+      for (WindowSource* window : windows_) {
+        if (window->id() == *id) {
+          return window;
+        }
+      }
+      return nullptr;
+    }
+    for (WindowSource* window : windows_) {
+      if (window->focused()) {
+        return window;
+      }
+    }
+    return windows_.empty() ? nullptr : windows_.front().get();
+  }
+
+  void OnClosed(int client) {
+    subscribers_.erase(client);
+    queries_.erase(client);
+  }
+
+  void OnLine(int client, std::string line) {
+    std::optional<base::DictValue> request =
+        base::JSONReader::ReadDict(line, base::JSON_PARSE_RFC);
+    if (!request) {
+      Error(client, nullptr, "not a JSON object");
+      return;
+    }
+    const base::Value* const id = request->Find("id");
+    const std::string* const command = request->FindString("cmd");
+    if (!command) {
+      Error(client, id, "missing cmd");
+      return;
+    }
+
+    if (*command == "hello") {
+      Reply(client, id,
+            base::DictValue().Set("ok", true).Set("version", kProtocolVersion));
+      return;
+    }
+    if (*command == "list") {
+      base::ListValue list;
+      for (WindowSource* window : windows_) {
+        list.Append(window->State());
+      }
+      Reply(client, id,
+            base::DictValue().Set("ok", true).Set("windows", std::move(list)));
+      return;
+    }
+    if (*command == "subscribe") {
+      subscribers_.insert(client);
+      Reply(client, id, base::DictValue().Set("ok", true));
+      for (WindowSource* window : windows_) {
+        Send(client, window->State());
+      }
+      return;
+    }
+    if (*command == "unsubscribe") {
+      subscribers_.erase(client);
+      Reply(client, id, base::DictValue().Set("ok", true));
+      return;
+    }
+
+    WindowSource* const window = FindWindow(*request);
+    if (!window) {
+      Error(client, id, "no such window");
+      return;
+    }
+
+    if (*command == "complete") {
+      const std::string* const text = request->FindString("text");
+      if (!text) {
+        Error(client, id, "missing text");
+        return;
+      }
+      Reply(client, id, base::DictValue().Set("ok", true));
+      // One query per client: a new one replaces the last.
+      queries_.erase(client);
+      queries_.emplace(
+          client, std::make_unique<Query>(
+                      window->profile(), client,
+                      id ? id->Clone() : base::Value(), window->id(), *text,
+                      base::BindRepeating(&Server::OnQueryResult,
+                                          base::Unretained(this))));
+      return;
+    }
+
+    content::WebContents* const contents = window->contents();
+    if (*command == "navigate") {
+      if (!contents) {
+        Error(client, id, "no tab");
+        return;
+      }
+      std::optional<GURL> url = UrlFor(*request, window->profile());
+      if (!url) {
+        Error(client, id, "missing url or text");
+        return;
+      }
+      if (!url->is_valid() || url->SchemeIs(url::kJavaScriptScheme)) {
+        Error(client, id, "not a URL that can be opened");
+        return;
+      }
+      content::NavigationController::LoadURLParams params(*url);
+      params.transition_type = ui::PageTransitionFromInt(
+          ui::PAGE_TRANSITION_TYPED | ui::PAGE_TRANSITION_FROM_ADDRESS_BAR);
+      contents->GetController().LoadURLWithParams(params);
+      Reply(client, id,
+            base::DictValue().Set("ok", true).Set("url", url->spec()));
+      return;
+    }
+
+    static constexpr std::pair<std::string_view, int> kCommands[] = {
+        {"reload", IDC_RELOAD},
+        {"reload_bypassing_cache", IDC_RELOAD_BYPASSING_CACHE},
+        {"stop", IDC_STOP},
+        {"back", IDC_BACK},
+        {"forward", IDC_FORWARD},
+    };
+    for (const auto& [name, command_id] : kCommands) {
+      if (*command == name) {
+        const bool done =
+            chrome::BrowserCommandController::From(window->browser())
+                ->ExecuteCommand(command_id);
+        if (done) {
+          Reply(client, id, base::DictValue().Set("ok", true));
+        } else {
+          Error(client, id, "not available now");
+        }
+        return;
+      }
+    }
+    Error(client, id, "unknown cmd");
+  }
+
+  // "url" is opened as given; "text" is what one would type in the address
+  // bar: a URL, or words to search for.
+  static std::optional<GURL> UrlFor(const base::DictValue& request,
+                                    Profile* profile) {
+    if (const std::string* url = request.FindString("url")) {
+      return GURL(*url);
+    }
+    const std::string* const text = request.FindString("text");
+    if (!text) {
+      return std::nullopt;
+    }
+    AutocompleteMatch match;
+    AutocompleteClassifierFactory::GetForProfile(profile)->Classify(
+        base::UTF8ToUTF16(*text), /*prefer_keyword=*/false,
+        /*allow_exact_keyword_match=*/false,
+        metrics::OmniboxEventProto::OTHER, &match,
+        /*alternate_nav_url=*/nullptr);
+    return match.destination_url;
+  }
+
+  void OnQueryResult(const Query& query,
+                     const AutocompleteController& controller) {
+    base::DictValue message;
+    if (!query.request_id().is_none()) {
+      message.Set("id", query.request_id().Clone());
+    }
+    message.Set("event", "suggestions");
+    message.Set("source", "query");
+    message.Set("window", query.window());
+    message.Set("input", query.input());
+    message.Set("done", controller.done());
+    message.Set("suggestions", SuggestionsToList(controller.result()));
+    Send(query.client(), std::move(message));
+  }
+
+  static inline Server* instance_ = nullptr;
+
+  std::vector<raw_ptr<WindowSource>> windows_;
+  std::set<int> subscribers_;
+  std::map<int, std::unique_ptr<Query>> queries_;
+  base::WeakPtrFactory<Server> weak_factory_{this};
+  // Last, so that it is destroyed (and stops calling back) first.
+  base::SequenceBound<SocketIo> io_;
+};
+
+WindowSource::WindowSource(BrowserView* browser_view)
+    : browser_(browser_view->browser()),
+      id_(browser_view->browser()->GetSessionID().id()),
+      widget_(browser_view->GetWidget()) {
+  browser_->GetTabStripModel()->AddObserver(this);
+  ObserveActiveTab();
+  if (widget_) {
+    widget_observation_.Observe(widget_);
+  }
+  if (LocationBarView* location_bar = browser_view->GetLocationBarView()) {
+    if (OmniboxController* omnibox = location_bar->GetOmniboxController()) {
+      autocomplete_observation_.Observe(omnibox->autocomplete_controller());
+    }
+  }
+  Server::AddWindow(this);
+}
+
+WindowSource::~WindowSource() {
+  Server::RemoveWindow(this);
+  browser_->GetTabStripModel()->RemoveObserver(this);
+}
+
+void WindowSource::Changed() {
+  if (Server* server = Server::instance()) {
+    server->BroadcastState(*this);
+  }
+}
+
+void WindowSource::OnResultChanged(AutocompleteController* controller,
+                                   bool default_match_changed) {
+  if (Server* server = Server::instance()) {
+    server->BroadcastAddressBarSuggestions(*this, *controller);
+  }
+}
