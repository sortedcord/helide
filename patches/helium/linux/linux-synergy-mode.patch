+// The address bar socket: other programs running as the user can follow and
+// drive each browser window's address bar over a Unix socket at
+// $XDG_RUNTIME_DIR/helide-address-bar.sock, one JSON object per line. See
+// docs/address-bar-ipc.md for the protocol.
+//
+// A window is on the socket while its registration lives; the socket exists
+// while any window is registered. Synergy mode registers its windows.
+class AddressBarIpcRegistration {
+ public:
+  virtual ~AddressBarIpcRegistration() = default;
+};
+
+// Not for off-the-record windows, which are never reported.
+std::unique_ptr<AddressBarIpcRegistration> RegisterWindowForAddressBarIpc(
+    BrowserView* browser_view);
+
