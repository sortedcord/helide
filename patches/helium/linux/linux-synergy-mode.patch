+
+// ---------------------------------------------------------------------------
+// The socket itself, on a thread pool sequence. Lines are handed to the UI
+// thread as they arrive; replies come back the same way.
+class SocketIo {
+ public:
+  using LineCallback = base::RepeatingCallback<void(int client, std::string)>;
+  using ClosedCallback = base::RepeatingCallback<void(int client)>;
+
+  SocketIo(base::FilePath path, LineCallback on_line, ClosedCallback on_closed)
+      : path_(std::move(path)),
+        on_line_(std::move(on_line)),
+        on_closed_(std::move(on_closed)) {
+    Listen();
+  }
+  SocketIo(const SocketIo&) = delete;
+  SocketIo& operator=(const SocketIo&) = delete;
+
+  ~SocketIo() {
+    accept_watch_.reset();
+    clients_.clear();
+    if (listen_fd_.is_valid()) {
+      listen_fd_.reset();
+      unlink(path_.value().c_str());
+    }
+  }
+
+  void Send(int client, std::string line) {
+    auto it = clients_.find(client);
+    if (it == clients_.end()) {
+      return;
+    }
+    line.push_back('\n');
+    it->second->out.append(line);
+    Flush(client);
+  }
+
+  void Broadcast(std::vector<int> clients, std::string line) {
+    for (int client : clients) {
+      Send(client, line);
+    }
+  }
+
+ private:
+  struct Client {
+    base::ScopedFD fd;
+    std::string in;
+    std::string out;
+    std::unique_ptr<base::FileDescriptorWatcher::Controller> read_watch;
+    std::unique_ptr<base::FileDescriptorWatcher::Controller> write_watch;
+  };
+
+  static sockaddr_un Address(const base::FilePath& path, bool* ok) {
+    sockaddr_un address = {};
+    address.sun_family = AF_UNIX;
+    *ok = path.value().size() < sizeof(address.sun_path);
+    if (*ok) {
+      std::copy(path.value().begin(), path.value().end(), address.sun_path);
+    }
+    return address;
+  }
+
+  void Listen() {
+    bool ok = false;
+    const sockaddr_un address = Address(path_, &ok);
+    if (!ok) {
+      LOG(ERROR) << "Address bar socket: path too long: " << path_;
+      return;
+    }
+
+    // Another Helide (another profile directory) may own the socket. Only a
+    // socket nobody answers on is taken over.
+    {
+      base::ScopedFD probe(
+          socket(AF_UNIX, SOCK_STREAM | SOCK_CLOEXEC, /*protocol=*/0));
+      if (probe.is_valid() &&
+          connect(probe.get(), reinterpret_cast<const sockaddr*>(&address),
+                  sizeof(address)) == 0) {
+        LOG(WARNING) << "Address bar socket: " << path_
+                     << " is in use by another browser; not serving it";
+        return;
+      }
+    }
+    unlink(path_.value().c_str());
+
+    base::ScopedFD fd(socket(AF_UNIX, SOCK_STREAM | SOCK_NONBLOCK | SOCK_CLOEXEC,
+                             /*protocol=*/0));
+    if (!fd.is_valid()) {
+      PLOG(ERROR) << "Address bar socket: socket";
+      return;
+    }
+    // Only the user may connect, also where the runtime directory is not
+    // private.
+    const mode_t old_mask = umask(0077);
+    const int bound = bind(fd.get(), reinterpret_cast<const sockaddr*>(&address),
+                           sizeof(address));
+    umask(old_mask);
+    if (bound != 0 || listen(fd.get(), /*backlog=*/16) != 0) {
+      PLOG(ERROR) << "Address bar socket: cannot listen on " << path_;
+      return;
+    }
+    listen_fd_ = std::move(fd);
+    accept_watch_ = base::FileDescriptorWatcher::WatchReadable(
+        listen_fd_.get(), base::BindRepeating(&SocketIo::OnAcceptable,
+                                              base::Unretained(this)));
+    VLOG(1) << "Address bar socket: listening on " << path_;
+  }
+
+  void OnAcceptable() {
+    while (true) {
+      base::ScopedFD fd(HANDLE_EINTR(accept4(listen_fd_.get(), nullptr, nullptr,
+                                             SOCK_NONBLOCK | SOCK_CLOEXEC)));
+      if (!fd.is_valid()) {
+        return;
+      }
+      ucred credentials = {};
+      socklen_t length = sizeof(credentials);
+      if (getsockopt(fd.get(), SOL_SOCKET, SO_PEERCRED, &credentials,
+                     &length) != 0 ||
+          credentials.uid != getuid()) {
+        continue;
+      }
+      const int id = next_client_++;
+      auto client = std::make_unique<Client>();
+      client->fd = std::move(fd);
+      client->read_watch = base::FileDescriptorWatcher::WatchReadable(
+          client->fd.get(), base::BindRepeating(&SocketIo::OnReadable,
+                                                base::Unretained(this), id));
+      clients_.emplace(id, std::move(client));
+    }
+  }
+
+  void OnReadable(int id) {
+    auto it = clients_.find(id);
+    if (it == clients_.end()) {
+      return;
+    }
+    Client& client = *it->second;
+    char buffer[16 * 1024];
+    while (true) {
+      const ssize_t n = HANDLE_EINTR(read(client.fd.get(), buffer, sizeof(buffer)));
+      if (n == 0 || (n < 0 && errno != EAGAIN && errno != EWOULDBLOCK)) {
+        Close(id);
+        return;
+      }
+      if (n < 0) {
+        break;
+      }
+      client.in.append(buffer, static_cast<size_t>(n));
+    }
+    size_t start = 0;
+    for (size_t newline; (newline = client.in.find('\n', start)) !=
+                         std::string::npos;
+         start = newline + 1) {
+      std::string line = client.in.substr(start, newline - start);
+      if (!line.empty() && line.back() == '\r') {
+        line.pop_back();
+      }
+      if (!line.empty()) {
+        on_line_.Run(id, std::move(line));
+      }
+    }
+    client.in.erase(0, start);
+    if (client.in.size() > kMaxLineLength) {
+      Close(id);
+    }
+  }
+
+  void Flush(int id) {
+    auto it = clients_.find(id);
+    if (it == clients_.end()) {
+      return;
+    }
+    Client& client = *it->second;
+    while (!client.out.empty()) {
+      const ssize_t n = HANDLE_EINTR(
+          send(client.fd.get(), client.out.data(), client.out.size(),
+               MSG_NOSIGNAL));
+      if (n < 0) {
+        if (errno != EAGAIN && errno != EWOULDBLOCK) {
+          Close(id);
+          return;
+        }
+        break;
+      }
+      client.out.erase(0, static_cast<size_t>(n));
+    }
+    if (client.out.size() > kMaxPendingOutput) {
+      Close(id);
+      return;
+    }
+    if (client.out.empty()) {
+      client.write_watch.reset();
+    } else if (!client.write_watch) {
+      client.write_watch = base::FileDescriptorWatcher::WatchWritable(
+          client.fd.get(),
+          base::BindRepeating(&SocketIo::Flush, base::Unretained(this), id));
+    }
+  }
+
+  void Close(int id) {
+    if (clients_.erase(id)) {
+      on_closed_.Run(id);
+    }
+  }
+
+  const base::FilePath path_;
+  const LineCallback on_line_;
+  const ClosedCallback on_closed_;
+  base::ScopedFD listen_fd_;
+  std::unique_ptr<base::FileDescriptorWatcher::Controller> accept_watch_;
+  std::map<int, std::unique_ptr<Client>> clients_;
+  int next_client_ = 1;
+};
+
+// ---------------------------------------------------------------------------
+
+base::ListValue SuggestionsToList(const AutocompleteResult& result) {
+  base::ListValue list;
+  for (const AutocompleteMatch& match : result) {
+    if (list.size() >= kMaxSuggestions) {
+      break;
+    }
+    list.Append(
+        base::DictValue()
+            .Set("contents", base::UTF16ToUTF8(match.contents))
+            .Set("description", base::UTF16ToUTF8(match.description))
+            .Set("url", match.destination_url.possibly_invalid_spec())
+            .Set("fill", base::UTF16ToUTF8(match.fill_into_edit))
+            .Set("type", AutocompleteMatchTypeToString(match.type))
+            .Set("default", match.allowed_to_be_default_match));
+  }
+  return list;
+}
