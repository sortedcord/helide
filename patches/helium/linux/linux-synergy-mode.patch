+
+class BrowserView;
+class BrowserWindowInterface;
+class ExpandOnHoverLock;
+class LocationBarView;
+class ToolbarView;
+class VerticalTabStripRegionView;
+
+namespace helium {
+
+class AddressBarIpcRegistration;
+class SynergyBottomRow;
+class SynergyTopRow;
+
+// Synergy mode, for the vertical tab layout. The toolbar row goes away: the
+// address bar moves to the top of the vertical tab strip, the toolbar (without
+// its navigation buttons) to the bottom of it, and the web contents take the
+// height the toolbar used. When the strip is collapsed, the address bar becomes
+// an icon and the toolbar shows only the app menu.
+//
+// With autohide on, the address bar (and the loading bar inside it) is hidden
+// while the window is focused. Ctrl+L then does nothing; Ctrl+Shift+L shows it
+// until focus leaves it.
+//
+// The views are moved, not copied, so everything that finds them through the
+// toolbar keeps working. They are moved back when the mode is turned off, and
+// before the window's views are torn down.
+class SynergyController : public views::WidgetObserver,
+                          public views::ViewObserver,
+                          public views::FocusChangeListener,
+                          public ui::EventObserver {
+ public:
+  DECLARE_USER_DATA(SynergyController);
+
+  // Creates the controller for a normal browser window. It deletes itself
+  // when the window's widget is destroyed.
+  static void MaybeCreateForBrowserView(BrowserView* browser_view);
+  static SynergyController* From(BrowserWindowInterface* browser);
+
+  SynergyController(const SynergyController&) = delete;
+  SynergyController& operator=(const SynergyController&) = delete;
+
+  // Ctrl+Shift+L. Shows and focuses the auto-hidden address bar, or hides it
+  // again. Does nothing (and returns false) unless autohide is in effect.
+  bool ToggleAddressBarReveal();
+
+  bool active() const { return active_; }
+
+  // Called by the rows.
+  void FocusAddressBar();
+  void OnToolbarCompactChanged(bool compact);
+
+ private:
+  explicit SynergyController(BrowserView* browser_view);
+  ~SynergyController() override;
+
+  // views::WidgetObserver:
+  void OnWidgetDestroying(views::Widget* widget) override;
+
+  // views::ViewObserver:
+  void OnViewVisibilityChanged(views::View* observed_view,
+                               views::View* starting_view,
+                               bool visible) override;
+  void OnChildViewAdded(views::View* observed_view,
+                        views::View* child) override;
+  void OnViewIsDeleting(views::View* observed_view) override;
+
+  // views::FocusChangeListener:
+  void OnWillChangeFocus(views::View* focused_before,
+                         views::View* focused_now) override {}
+  void OnDidChangeFocus(views::View* focused_before,
+                        views::View* focused_now) override;
+
+  // ui::EventObserver:
+  void OnEvent(const ui::Event& event) override;
+
+  void ScheduleUpdate();
+  void Update();
+  bool ShouldBeActive() const;
+  bool AutohideEnabled() const;
+  void Activate();
+  void Deactivate();
+  void UpdateAddressBarVisibility();
+  void UpdateToolbarButtons();
+  void SetHidden(views::View* view, bool hidden);
+  void OnPaintAsActiveChanged();
+  void OnAutohideDelayElapsed();
+  bool FocusIsInAddressBar() const;
+  void Teardown();
+
+  VerticalTabStripRegionView* region() const;
+  ToolbarView* toolbar() const;
+  LocationBarView* location_bar() const;
+
+  raw_ptr<BrowserView> browser_view_;
+  raw_ptr<views::Widget> widget_;
+  std::optional<ui::ScopedUnownedUserData<SynergyController>>
+      scoped_unowned_user_data_;
+
+  PrefChangeRegistrar pref_change_registrar_;
+  base::CallbackListSubscription layout_subscription_;
+  base::CallbackListSubscription vertical_mode_subscription_;
+  base::CallbackListSubscription paint_as_active_subscription_;
+  base::ScopedObservation<views::Widget, views::WidgetObserver>
+      widget_observation_{this};
+  raw_ptr<views::FocusManager> focus_manager_ = nullptr;
+
+  bool active_ = false;
+  bool update_pending_ = false;
+
+  // Where the toolbar and the location bar were before they were moved.
+  size_t toolbar_index_ = 0;
+  size_t location_bar_index_ = 0;
+
+  // The rows in the vertical tab strip that hold them.
+  raw_ptr<SynergyTopRow> top_row_ = nullptr;
+  raw_ptr<SynergyBottomRow> bottom_row_ = nullptr;
+
+  // Toolbar buttons left of the address bar (back, forward, reload, home...),
+  // which Synergy mode does not show.
+  std::vector<std::unique_ptr<views::ViewTracker>> leading_views_;
+  base::ScopedObservation<views::View, views::ViewObserver>
+      toolbar_observation_{this};
+
+  // Toolbar children hidden by Synergy mode, and whether they would be visible
+  // without it, so they can be put back as they were.
+  std::map<views::View*, bool> hidden_;
+  base::ScopedMultiSourceObservation<views::View, views::ViewObserver>
+      hidden_observations_{this};
+  bool changing_visibility_ = false;
+
+  bool toolbar_compact_ = false;
+
+  // Autohide: the address bar was asked for with Ctrl+Shift+L, or clicked
+  // while it showed, and stays until focus leaves it.
+  bool revealed_ = false;
+  base::OneShotTimer autohide_delay_timer_;
+  // Watches for clicks on the address bar.
+  std::unique_ptr<views::EventMonitor> click_monitor_;
+
+  // The window on the address bar socket, while Synergy mode is on.
+  std::unique_ptr<AddressBarIpcRegistration> ipc_registration_;
+
+  // Keeps a collapsed strip expanded while the address bar has focus.
+  std::unique_ptr<ExpandOnHoverLock> expand_lock_;
+
+  base::WeakPtrFactory<SynergyController> weak_factory_{this};
+};
+
+}  // namespace helium
