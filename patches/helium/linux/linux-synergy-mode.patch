+#ifndef CHROME_COMMON_HELIUM_SYNERGY_PREFS_H_
+#define CHROME_COMMON_HELIUM_SYNERGY_PREFS_H_
+
+namespace helium {
+
+// Linux only. A boolean pref, off by default. With the vertical tab layout,
+// Synergy mode removes the toolbar row: the address bar moves to the top of
+// the vertical tab strip, the toolbar buttons to its bottom, and the web
+// contents grow into the space the toolbar used.
+inline constexpr char kSynergyMode[] = "helium.browser.synergy_mode";
+
+// Linux only. A boolean pref, off by default. In Synergy mode, hides the
+// address bar (and with it the page loading bar) while the window is focused.
+// Ctrl+Shift+L shows it.
+inline constexpr char kSynergyAutohideAddressBar[] =
+    "helium.browser.synergy_autohide_address_bar";
+
+}  // namespace helium
