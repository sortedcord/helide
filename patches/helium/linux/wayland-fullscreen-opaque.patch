+// Nothing shows behind a fullscreen window, so it is drawn and declared
+// opaque. That lets the compositor skip blending it and, for fullscreen
+// video, scan it out directly, which saves power.
+bool IsFullscreen(const BrowserView* browser_view) {
+  const views::Widget* widget = browser_view->GetWidget();
+  return widget && widget->IsFullscreen();
+}
