+void WaylandSurface::set_background_blur_region(
+    const std::vector<gfx::Rect>& region_px) {
+  pending_state_.background_blur_region_px = region_px;
+  if (apply_state_immediately_) {
+    ApplyBackgroundBlurRegion();
+    state_.background_blur_region_px = region_px;
+  }
+}
+
+bool WaylandSurface::ApplyBackgroundBlurRegion() {
+  auto* manager = connection_->background_effect_manager();
+  if (!manager) {
+    return false;
+  }
+  if (!background_effect_surface_) {
+    if (pending_state_.background_blur_region_px.empty()) {
+      return false;
+    }
+    background_effect_surface_.reset(
+        ext_background_effect_manager_v1_get_background_effect(manager,
+                                                               surface_.get()));
+  }
+  // Region and scale use the same conversion as input/opaque regions. The
+  // effect state is committed atomically with the next wl_surface commit.
+  auto region = CreateAndAddRegion(pending_state_.background_blur_region_px,
+                                   GetWaylandScale(pending_state_));
+  ext_background_effect_surface_v1_set_blur_region(
+      background_effect_surface_.get(),
+      pending_state_.background_blur_region_px.empty() ? nullptr
+                                                       : region.get());
+  return true;
+}
