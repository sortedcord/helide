+void GestureNavSimple::StartPagePreview() {
+  page_transition_pending_ = true;
+  pending_delta_ = 0.f;
+  NavigationEntry* current_entry =
+      web_contents_->GetController().GetLastCommittedEntry();
+  pending_entry_id_ = current_entry ? current_entry->GetUniqueID() : 0;
+  SwipeSnapshotCapturer::CaptureCurrentPage(
+      web_contents_,
+      base::BindOnce(&GestureNavSimple::OnCurrentPageCaptured,
+                     page_transition_weak_factory_.GetWeakPtr(),
+                     ++page_transition_generation_));
+}
+
+void GestureNavSimple::OnCurrentPageCaptured(int generation,
+                                             SkBitmap current) {
+  if (!page_transition_pending_ || generation != page_transition_generation_) {
+    // The gesture ended before the snapshot arrived.
+    return;
+  }
+  page_transition_pending_ = false;
+
+  // This capture is taken while the page is stable, so it is a reliable
+  // snapshot of the entry being left (unlike captures for same-document
+  // navigations). Keep it for the way back.
+  if (pending_entry_id_ && !current.drawsNothing()) {
+    SwipeSnapshotCache::GetInstance().Put(web_contents_, pending_entry_id_,
+                                          current);
+  }
+
+  NavigationControllerImpl& controller = web_contents_->GetController();
+  const bool is_back = GetDirectionFromMode(mode_) == NavigationDirection::BACK;
+  NavigationEntry* destination = controller.GetEntryAtIndex(
+      controller.GetLastCommittedEntryIndex() + (is_back ? -1 : 1));
+  if (current.drawsNothing() || !destination) {
+    CreateAffordance();
+    if (affordance_ && completion_threshold_ > 0.f) {
+      affordance_->SetDragProgress(pending_delta_ / completion_threshold_);
+    }
+    return;
+  }
+
+  aura::Window* window = web_contents_->GetNativeView();
+  page_transition_ = std::make_unique<SwipePageTransition>(
+      web_contents_, is_back, window->bounds(), current,
+      SwipeSnapshotCache::GetInstance().Get(web_contents_,
+                                            destination->GetUniqueID()),
+      SwipePagePreview::AreTranslucentPagesEnabled(web_contents_),
+      base::BindOnce(&GestureNavSimple::OnPageTransitionFinished,
+                     page_transition_weak_factory_.GetWeakPtr()));
+  page_transition_->Attach(window->layer());
+  UpdatePagePreview(pending_delta_);
+}
+
+void GestureNavSimple::UpdatePagePreview(float delta) {
+  if (!page_transition_ || completion_threshold_ <= 0.f) {
+    return;
+  }
+  page_transition_->SetDragOffset(delta * kSwipePageGain);
+}
+
+void GestureNavSimple::OnPageTransitionFinished() {
+  // Called from inside the transition's animation; destroy it afterwards.
+  base::SequencedTaskRunner::GetCurrentDefault()->PostTask(
+      FROM_HERE, base::BindOnce(&GestureNavSimple::DestroyPageTransition,
+                                page_transition_weak_factory_.GetWeakPtr()));
+}
+
+void GestureNavSimple::DestroyPageTransition() {
+  // A new gesture may have started since the request was posted.
+  if (page_transition_ && page_transition_->IsFinishing()) {
+    page_transition_.reset();
+  }
+}
+
+void GestureNavSimple::CreateAffordance() {
+  aura::Window* window = web_contents_->GetNativeView();
+  affordance_ = std::make_unique<Affordance>(
+      this, mode_, window->bounds(), max_delta_ / completion_threshold_);
+
+  // Adding the affordance as a child of the content window is not sufficient,
+  // because it is possible for a new layer to be parented on top of the
+  // affordance layer (e.g. when the navigated-to page is displayed while the
+  // completion animation is in progress). So instead, it is installed on top of
+  // the content window as its sibling. Note that the affordance itself makes
+  // sure that its contents are clipped to the bounds given to it.
+  ui::Layer* parent = window->layer()->parent();
+  parent->Add(affordance_->root_layer());
+  parent->StackAtTop(affordance_->root_layer());
 }
 
