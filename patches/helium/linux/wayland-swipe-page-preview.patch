+#ifndef CONTENT_PUBLIC_BROWSER_SWIPE_PAGE_PREVIEW_H_
+#define CONTENT_PUBLIC_BROWSER_SWIPE_PAGE_PREVIEW_H_
+
+#include "content/common/content_export.h"
+
+namespace content {
+
+class WebContents;
+
+// Hook that lets the embedder decide, per WebContents and at the moment a
+// gesture starts, whether a touchpad swipe between history entries should
+// slide the page and reveal a snapshot of the destination page (instead of
+// only showing the small arrow affordance). Only used on Aura platforms.
+class CONTENT_EXPORT SwipePagePreview {
+ public:
+  using EnabledCallback = bool (*)(WebContents*);
+
+  SwipePagePreview() = delete;
+
+  // Registers the embedder callback. It is queried when a swipe gesture
+  // begins and before snapshots are captured. Not owned; must outlive use.
+  static void SetEnabledCallback(EnabledCallback callback);
+
+  // Returns true if the page-slide preview is enabled for |web_contents|.
+  // Returns false if no callback has been registered.
+  static bool IsEnabled(WebContents* web_contents);
+
+  // Registers the embedder callback that reports whether pages of
+  // |web_contents| are shown translucent (e.g. the window lets the desktop
+  // show through transparent page backgrounds). While swiping, the slide is
+  // then drawn without an opaque background so it keeps that translucency.
+  static void SetTranslucentPagesCallback(EnabledCallback callback);
+
+  // Returns true if pages of |web_contents| are translucent. Returns false if
+  // no callback has been registered.
+  static bool AreTranslucentPagesEnabled(WebContents* web_contents);
+};
+
+}  // namespace content
