+// Paints a page snapshot (or a flat color if there is none) scaled to fill the
+// layer.
+class SnapshotPaintLayer : public ui::LayerDelegate {
+ public:
+  SnapshotPaintLayer(const gfx::Size& size,
+                     const SkBitmap& bitmap,
+                     SkColor fallback,
+                     bool opaque)
+      : fallback_(fallback) {
+    if (!bitmap.drawsNothing()) {
+      image_ = gfx::ImageSkia::CreateFromBitmap(bitmap, 1.f);
+    }
+    layer_.SetBounds(gfx::Rect(size));
+    layer_.SetFillsBoundsOpaquely(opaque);
+    layer_.set_delegate(this);
+  }
+
+  SnapshotPaintLayer(const SnapshotPaintLayer&) = delete;
+  SnapshotPaintLayer& operator=(const SnapshotPaintLayer&) = delete;
+
+  ~SnapshotPaintLayer() override { layer_.set_delegate(nullptr); }
+
+  ui::Layer* layer() { return &layer_; }
+
+ private:
+  // ui::LayerDelegate:
+  void OnPaintLayer(const ui::PaintContext& context) override {
+    ui::PaintRecorder recorder(context, layer_.size());
+    gfx::Canvas* canvas = recorder.canvas();
+    canvas->DrawColor(fallback_);
+    if (!image_.isNull()) {
+      canvas->DrawImageInt(image_, 0, 0, image_.width(), image_.height(), 0, 0,
+                           layer_.size().width(), layer_.size().height(),
+                           /*filter=*/true);
+    }
+  }
+  void OnDeviceScaleFactorChanged(float old_device_scale_factor,
+                                  float new_device_scale_factor) override {}
+
+  ui::LayerTextured layer_;
+  gfx::ImageSkia image_;
+  const SkColor fallback_;
+};
+
+// Paints the soft shadow cast by the moving page onto the page beneath.
+class ShadowPaintLayer : public ui::LayerDelegate {
+ public:
+  // |darkest_on_right|: the darkest strip is at the layer's right edge (the
+  // shadow of a page moving to the right sits to its left, against the page).
+  ShadowPaintLayer(const gfx::Rect& bounds, bool darkest_on_right)
+      : darkest_on_right_(darkest_on_right) {
+    layer_.SetBounds(bounds);
+    layer_.SetFillsBoundsOpaquely(false);
+    layer_.set_delegate(this);
+  }
+
+  ShadowPaintLayer(const ShadowPaintLayer&) = delete;
+  ShadowPaintLayer& operator=(const ShadowPaintLayer&) = delete;
+
+  ~ShadowPaintLayer() override { layer_.set_delegate(nullptr); }
+
+  ui::Layer* layer() { return &layer_; }
+
+ private:
+  // ui::LayerDelegate:
+  void OnPaintLayer(const ui::PaintContext& context) override {
+    ui::PaintRecorder recorder(context, layer_.size());
+    gfx::Canvas* canvas = recorder.canvas();
+    const int width = layer_.size().width();
+    const int height = layer_.size().height();
+    for (int i = 0; i < width; ++i) {
+      // t: 0 far from the page edge, 1 at the page edge.
+      const float t = static_cast<float>(i + 1) / static_cast<float>(width);
+      const float strength = t * t * t;
+      const int x = darkest_on_right_ ? i : width - 1 - i;
+      canvas->FillRect(gfx::Rect(x, 0, 1, height),
+                       SkColorSetA(SK_ColorBLACK,
+                                   static_cast<int>(strength *
+                                                    kShadowPeakAlpha * 255)));
+    }
+  }
+  void OnDeviceScaleFactorChanged(float old_device_scale_factor,
+                                  float new_device_scale_factor) override {}
+
+  ui::LayerTextured layer_;
+  const bool darkest_on_right_;
+};
