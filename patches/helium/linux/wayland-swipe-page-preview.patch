+class SnapshotPaintLayer;
+class ShadowPaintLayer;
+
+// Process-wide, size-bounded LRU of page snapshots, keyed by (WebContents,
+// NavigationEntry unique id). A snapshot is the content area as it looked when
+// the user navigated away from that entry.
+class SwipeSnapshotCache {
+ public:
+  static SwipeSnapshotCache& GetInstance();
+
+  SwipeSnapshotCache(const SwipeSnapshotCache&) = delete;
+  SwipeSnapshotCache& operator=(const SwipeSnapshotCache&) = delete;
+
+  void Put(const void* owner, int entry_id, const SkBitmap& bitmap);
+  // Returns a null bitmap if there is no snapshot.
+  SkBitmap Get(const void* owner, int entry_id);
+  void RemoveOwner(const void* owner);
+
+ private:
+  friend class base::NoDestructor<SwipeSnapshotCache>;
+  SwipeSnapshotCache();
+  ~SwipeSnapshotCache();
+
+  struct Item {
+    const void* owner;
+    int entry_id;
+    SkBitmap bitmap;
+  };
+  void Trim();
+
+  std::list<Item> items_;
+  size_t total_bytes_ = 0;
+};
+
+// Captures a snapshot of the displayed page whenever a main frame navigation
+// is about to leave it, so it can be shown later during a swipe gesture.
+class SwipeSnapshotCapturer : public WebContentsObserver {
+ public:
+  explicit SwipeSnapshotCapturer(WebContents* web_contents);
+  ~SwipeSnapshotCapturer() override;
+
+  // Asynchronously copies the pixels of the currently displayed page.
+  // |callback| receives a null bitmap on failure. Always runs asynchronously
+  // or synchronously on the calling sequence.
+  static void CaptureCurrentPage(WebContents* web_contents,
+                                 base::OnceCallback<void(SkBitmap)> callback);
+
+ private:
+  // WebContentsObserver:
+  void DidStartNavigation(NavigationHandle* navigation_handle) override;
+
+  void OnCaptured(int entry_id, SkBitmap bitmap);
+
+  const raw_ptr<const void> owner_;
+  int last_entry_id_ = 0;
+  base::TimeTicks last_capture_time_;
+  base::WeakPtrFactory<SwipeSnapshotCapturer> weak_factory_{this};
+};
+
+// A Safari-style page slide: the current page (a snapshot of it) follows the
+// swipe, uncovering a snapshot of the destination history entry that moves
+// with parallax underneath. The overlay is installed as a sibling above the
+// WebContents native window and removed once the real navigation has
+// presented.
+class CONTENT_EXPORT SwipePageTransition : public gfx::AnimationDelegate,
+                                           public WebContentsObserver {
+ public:
+  // |is_back|: the page slides to the right (back) rather than to the left.
+  // |destination| may be a null bitmap, in which case a plain themed
+  // background is shown.
+  SwipePageTransition(WebContents* web_contents,
+                      bool is_back,
+                      const gfx::Rect& bounds,
+                      const SkBitmap& current,
+                      const SkBitmap& destination,
+                      bool translucent,
+                      base::OnceClosure on_finished);
+  ~SwipePageTransition() override;
+
+  // Installs the overlay above all other children of |parent|, which must be
+  // the content window's layer.
+  void Attach(ui::Layer* parent);
+
+  int width() const { return bounds_.width(); }
+
+  // Sets how far the page has been dragged, in DIPs, in [0, width()].
+  void SetDragOffset(float offset);
+
+  // Animates back to the original page and then finishes.
+  void Abort();
+
+  // The navigation was triggered: finish the slide and keep the destination
+  // snapshot visible until the new page has presented.
+  void Commit();
+
+  bool IsFinishing() const { return state_ != State::kDragging; }
+
+ private:
+  enum class State { kDragging, kAborting, kCommitting, kHolding, kFading };
+
+  void ApplyProgress(float progress);
+  void StartAnimation(base::TimeDelta duration);
+  void MaybeStartDismiss();
+  void StartFade();
+  void Finish();
+
+  // gfx::AnimationDelegate:
+  void AnimationEnded(const gfx::Animation* animation) override;
+  void AnimationProgressed(const gfx::Animation* animation) override;
+  void AnimationCanceled(const gfx::Animation* animation) override;
+
+  // WebContentsObserver:
+  void DidFinishNavigation(NavigationHandle* navigation_handle) override;
+  void RenderFrameHostChanged(RenderFrameHost* old_host,
+                              RenderFrameHost* new_host) override;
+
+  // Keeps the overlay above any view added by the navigation.
+  void StackAtTop();
+
+  // With translucent pages the real page is hidden while the overlay shows.
+  void HideLiveContent();
+  void RestoreLiveContent();
+
+  const bool is_back_;
+  const bool translucent_;
+  bool live_content_hidden_ = false;
+  const gfx::Rect bounds_;
+  base::OnceClosure on_finished_;
+
+  State state_ = State::kDragging;
+  float progress_ = 0.f;
+  float animation_from_ = 0.f;
+  float animation_to_ = 0.f;
+  bool navigation_done_ = false;
+  bool finished_ = false;
+
+  ui::LayerNotDrawn root_layer_;
+  ui::LayerSolidColor backdrop_layer_;
+  // The pages form a stack. The page underneath stays still; the page on top
+  // slides. Going back, the current page is on top and slides out to the
+  // right, uncovering the previous page. Going forward, the next page is on
+  // top and slides in from the right over the current page.
+  // Clips the page underneath to the strip the page on top has uncovered, so
+  // it never shows through the top page's transparent areas.
+  ui::LayerNotDrawn under_clip_;
+  std::unique_ptr<SnapshotPaintLayer> under_;
+  ui::LayerSolidColor dim_layer_;
+  ui::LayerNotDrawn over_container_;
+  std::unique_ptr<SnapshotPaintLayer> over_;
+  std::unique_ptr<ShadowPaintLayer> shadow_;
+
+  std::unique_ptr<gfx::LinearAnimation> animation_;
+  base::OneShotTimer settle_timer_;
+  base::OneShotTimer hold_timeout_timer_;
+};
+
+}  // namespace content
