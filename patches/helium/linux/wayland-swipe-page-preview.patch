+// static
+SwipeSnapshotCache& SwipeSnapshotCache::GetInstance() {
+  static base::NoDestructor<SwipeSnapshotCache> instance;
+  return *instance;
+}
+
+SwipeSnapshotCache::SwipeSnapshotCache() = default;
+SwipeSnapshotCache::~SwipeSnapshotCache() = default;
+
+void SwipeSnapshotCache::Put(const void* owner,
+                             int entry_id,
+                             const SkBitmap& bitmap) {
+  if (bitmap.drawsNothing()) {
+    return;
+  }
+  for (auto it = items_.begin(); it != items_.end(); ++it) {
+    if (it->owner == owner && it->entry_id == entry_id) {
+      total_bytes_ -= it->bitmap.computeByteSize();
+      items_.erase(it);
+      break;
+    }
+  }
+  total_bytes_ += bitmap.computeByteSize();
+  items_.push_front({owner, entry_id, bitmap});
+  Trim();
+}
+
+SkBitmap SwipeSnapshotCache::Get(const void* owner, int entry_id) {
+  for (auto it = items_.begin(); it != items_.end(); ++it) {
+    if (it->owner == owner && it->entry_id == entry_id) {
+      items_.splice(items_.begin(), items_, it);
+      return items_.front().bitmap;
+    }
+  }
+  return SkBitmap();
+}
+
+void SwipeSnapshotCache::RemoveOwner(const void* owner) {
+  for (auto it = items_.begin(); it != items_.end();) {
+    if (it->owner == owner) {
+      total_bytes_ -= it->bitmap.computeByteSize();
+      it = items_.erase(it);
+    } else {
+      ++it;
+    }
+  }
+}
+
+void SwipeSnapshotCache::Trim() {
+  while (total_bytes_ > kMaxCacheBytes && items_.size() > 1) {
+    total_bytes_ -= items_.back().bitmap.computeByteSize();
+    items_.pop_back();
+  }
+}
+
+////////////////////////////////////////////////////////////////////////////////
+// SwipeSnapshotCapturer
+
+SwipeSnapshotCapturer::SwipeSnapshotCapturer(WebContents* web_contents)
+    : WebContentsObserver(web_contents), owner_(web_contents) {}
+
+SwipeSnapshotCapturer::~SwipeSnapshotCapturer() {
+  SwipeSnapshotCache::GetInstance().RemoveOwner(owner_);
+}
+
+// static
+void SwipeSnapshotCapturer::CaptureCurrentPage(
+    WebContents* web_contents,
+    base::OnceCallback<void(SkBitmap)> callback) {
+  RenderWidgetHostView* view = web_contents->GetRenderWidgetHostView();
+  if (!view || !view->IsShowing()) {
+    std::move(callback).Run(SkBitmap());
+    return;
+  }
+  // The copy callback may run on any sequence: bounce the result back here.
+  view->CopyFromSurface(
+      gfx::Rect(), gfx::Size(), base::TimeDelta(),
+      base::BindOnce(
+          [](scoped_refptr<base::SequencedTaskRunner> runner,
+             base::OnceCallback<void(SkBitmap)> callback,
+             const CopyFromSurfaceResult& result) {
+            SkBitmap bitmap = result.has_value() ? result->bitmap : SkBitmap();
+            runner->PostTask(FROM_HERE, base::BindOnce(std::move(callback),
+                                                       std::move(bitmap)));
+          },
+          base::SequencedTaskRunner::GetCurrentDefault(),
+          std::move(callback)));
+}
+
+void SwipeSnapshotCapturer::DidStartNavigation(
+    NavigationHandle* navigation_handle) {
+  if (!navigation_handle->IsInPrimaryMainFrame()) {
+    return;
+  }
+  // A same-document navigation (fragment, pushState, ...) has already changed
+  // what the page shows by the time the browser hears about it, so a capture
+  // now would record the *new* state under the old entry. Pages left this
+  // way are captured when a swipe gesture starts instead.
+  if (navigation_handle->IsSameDocument()) {
+    return;
+  }
+  if (!SwipePagePreview::IsEnabled(web_contents())) {
+    return;
+  }
+  NavigationEntry* entry = web_contents()->GetController().GetLastCommittedEntry();
+  if (!entry) {
+    return;
+  }
+  const int entry_id = entry->GetUniqueID();
+  const base::TimeTicks now = base::TimeTicks::Now();
+  if (entry_id == last_entry_id_ &&
+      now - last_capture_time_ < kMinCaptureInterval) {
+    return;
+  }
+  last_entry_id_ = entry_id;
+  last_capture_time_ = now;
+  CaptureCurrentPage(
+      web_contents(),
+      base::BindOnce(&SwipeSnapshotCapturer::OnCaptured,
+                     weak_factory_.GetWeakPtr(), entry_id));
+}
+
+void SwipeSnapshotCapturer::OnCaptured(int entry_id, SkBitmap bitmap) {
+  SwipeSnapshotCache::GetInstance().Put(owner_, entry_id, bitmap);
+}
+
+////////////////////////////////////////////////////////////////////////////////
+// SwipePageTransition
+
+SwipePageTransition::SwipePageTransition(WebContents* web_contents,
+                                         bool is_back,
+                                         const gfx::Rect& bounds,
+                                         const SkBitmap& current,
+                                         const SkBitmap& destination,
+                                         bool translucent,
+                                         base::OnceClosure on_finished)
+    : WebContentsObserver(web_contents),
+      is_back_(is_back),
+      translucent_(translucent),
+      bounds_(bounds),
+      on_finished_(std::move(on_finished)) {
+  const gfx::Size size = bounds.size();
+  // When pages are translucent the slide must not paint an opaque background,
+  // or the desktop would stop showing through for the length of the swipe.
+  const SkColor fallback =
+      translucent_ ? SK_ColorTRANSPARENT : FallbackBackgroundColor();
+
+  // The overlay is a child of the content window's layer, so its origin is
+  // the window's own (0, 0).
+  root_layer_.SetBounds(gfx::Rect(size));
+  root_layer_.SetMasksToBounds(true);
+
+  if (!translucent_) {
+    backdrop_layer_.SetBounds(gfx::Rect(size));
+    backdrop_layer_.SetColor(SkColor4f::FromColor(fallback));
+    root_layer_.Add(&backdrop_layer_);
+  }
+
+  // Back: the current page is on top, the previous page underneath.
+  // Forward: the next page is on top, the current page underneath.
+  under_clip_.SetBounds(gfx::Rect(size));
+  under_clip_.SetMasksToBounds(true);
+  root_layer_.Add(&under_clip_);
+
+  under_ = std::make_unique<SnapshotPaintLayer>(
+      size, is_back_ ? destination : current, fallback, !translucent_);
+  under_clip_.Add(under_->layer());
+
+  dim_layer_.SetBounds(gfx::Rect(size));
+  dim_layer_.SetColor(SkColors::kBlack);
+  under_clip_.Add(&dim_layer_);
+
+  over_container_.SetBounds(gfx::Rect(size));
+  root_layer_.Add(&over_container_);
+
+  over_ = std::make_unique<SnapshotPaintLayer>(
+      size, is_back_ ? current : destination, fallback, !translucent_);
+  over_container_.Add(over_->layer());
+
+  // The sliding page always casts its shadow on the page beneath from its
+  // left edge.
+  shadow_ = std::make_unique<ShadowPaintLayer>(
+      gfx::Rect(-kShadowWidth, 0, kShadowWidth, size.height()),
+      /*darkest_on_right=*/true);
+  over_container_.Add(shadow_->layer());
+
+  ApplyProgress(0.f);
+}
+
+SwipePageTransition::~SwipePageTransition() {
+  // Make sure no animation callbacks arrive during member destruction.
+  animation_.reset();
+  RestoreLiveContent();
+}
+
+void SwipePageTransition::Attach(ui::Layer* parent) {
+  parent->Add(&root_layer_);
+  parent->StackAtTop(&root_layer_);
+  if (translucent_) {
+    HideLiveContent();
+  }
+}
+
+void SwipePageTransition::HideLiveContent() {
+  ui::Layer* parent = root_layer_.parent();
+  if (!parent) {
+    return;
+  }
+  // The real page would show through the transparent parts of the snapshots,
+  // so hide it while the overlay stands in for it. New views added by a
+  // navigation are hidden too (see RenderFrameHostChanged()).
+  for (ui::Layer* child : parent->children()) {
+    if (child != &root_layer_) {
+      child->SetOpacity(0.f);
+    }
+  }
+  live_content_hidden_ = true;
+}
+
+void SwipePageTransition::RestoreLiveContent() {
+  if (!live_content_hidden_) {
+    return;
+  }
+  live_content_hidden_ = false;
+  ui::Layer* parent = root_layer_.parent();
+  if (!parent) {
+    return;
+  }
+  for (ui::Layer* child : parent->children()) {
+    if (child != &root_layer_) {
+      child->SetOpacity(1.f);
+    }
+  }
+}
+
+void SwipePageTransition::SetDragOffset(float offset) {
+  if (state_ != State::kDragging || width() <= 0) {
+    return;
+  }
+  ApplyProgress(std::clamp(offset / static_cast<float>(width()), 0.f, 1.f));
+}
+
+void SwipePageTransition::ApplyProgress(float progress) {
+  progress_ = progress;
+  const float w = static_cast<float>(width());
+  // |progress| is 0 with the current page showing and 1 with the destination
+  // page fully showing. Only the page on top moves.
+  const float over_offset = is_back_ ? progress * w : (1.f - progress) * w;
+  gfx::Transform over_transform;
+  over_transform.Translate(over_offset, 0);
+  over_container_.SetTransform(over_transform);
+
+  // The page underneath is only visible where the page on top has moved away,
+  // which is the strip [0, over_offset). The snapshot itself stays put.
+  under_clip_.SetBounds(
+      gfx::Rect(0, 0, std::clamp(static_cast<int>(std::lround(over_offset)), 0,
+                                 width()),
+                bounds_.height()));
+
+  // The page underneath darkens as it gets covered and lightens as it is
+  // uncovered.
+  const float covered = is_back_ ? 1.f - progress : progress;
+  dim_layer_.SetOpacity(translucent_ ? 0.f : kPreviewDim * covered);
+  // The shadow strip sits just outside the sliding page's left edge. When the
+  // page is at the screen edge that strip would poke into view, so fade it out.
+  shadow_->layer()->SetOpacity(std::min(1.f, covered * 8.f));
+}
+
+void SwipePageTransition::StartAnimation(base::TimeDelta duration) {
+  animation_from_ = progress_;
+  animation_ = std::make_unique<gfx::LinearAnimation>(
+      duration, gfx::LinearAnimation::kDefaultFrameRate, this);
+  animation_->Start();
+}
+
+void SwipePageTransition::Abort() {
+  if (state_ != State::kDragging) {
+    return;
+  }
+  state_ = State::kAborting;
+  animation_to_ = 0.f;
+  StartAnimation(kAbortDuration * std::max(progress_, 0.25f));
+}
+
+void SwipePageTransition::Commit() {
+  if (state_ != State::kDragging) {
+    return;
+  }
+  state_ = State::kCommitting;
+  animation_to_ = 1.f;
+  StartAnimation(kCommitDuration * std::max(1.f - progress_, 0.35f));
+  hold_timeout_timer_.Start(
+      FROM_HERE, kHoldTimeout,
+      base::BindOnce(&SwipePageTransition::StartFade, base::Unretained(this)));
+}
+
+void SwipePageTransition::MaybeStartDismiss() {
+  if (state_ != State::kHolding || !navigation_done_ ||
+      settle_timer_.IsRunning()) {
+    return;
+  }
+  settle_timer_.Start(
+      FROM_HERE, kSettleDelay,
+      base::BindOnce(&SwipePageTransition::StartFade, base::Unretained(this)));
+}
+
+void SwipePageTransition::StartFade() {
+  if (state_ == State::kFading || finished_) {
+    return;
+  }
+  hold_timeout_timer_.Stop();
+  settle_timer_.Stop();
+  state_ = State::kFading;
+  if (translucent_) {
+    // A cross-fade would show both the snapshot and the real page through
+    // each other, so swap them in one step.
+    animation_.reset();
+    Finish();
+    return;
+  }
+  animation_ = std::make_unique<gfx::LinearAnimation>(
+      kFadeDuration, gfx::LinearAnimation::kDefaultFrameRate, this);
+  animation_->Start();
+}
+
+void SwipePageTransition::Finish() {
+  if (finished_) {
+    return;
+  }
+  finished_ = true;
+  hold_timeout_timer_.Stop();
+  settle_timer_.Stop();
+  // Show the real page and drop the overlay in the same frame.
+  RestoreLiveContent();
+  root_layer_.SetVisible(false);
+  if (on_finished_) {
+    std::move(on_finished_).Run();
+  }
+}
+
+void SwipePageTransition::AnimationProgressed(const gfx::Animation* animation) {
+  const float t = animation->GetCurrentValue();
+  switch (state_) {
+    case State::kAborting:
+    case State::kCommitting: {
+      const float eased =
+          gfx::Tween::CalculateValue(gfx::Tween::FAST_OUT_SLOW_IN, t);
+      ApplyProgress(animation_from_ + (animation_to_ - animation_from_) * eased);
+      break;
+    }
+    case State::kFading:
+      root_layer_.SetOpacity(1.f - t);
+      break;
+    case State::kDragging:
+    case State::kHolding:
+      break;
+  }
+}
+
+void SwipePageTransition::AnimationEnded(const gfx::Animation* animation) {
+  switch (state_) {
+    case State::kAborting:
+      ApplyProgress(0.f);
+      Finish();
+      break;
+    case State::kCommitting:
+      ApplyProgress(1.f);
+      state_ = State::kHolding;
+      MaybeStartDismiss();
+      break;
+    case State::kFading:
+      Finish();
+      break;
+    case State::kDragging:
+    case State::kHolding:
+      break;
+  }
+}
+
+void SwipePageTransition::AnimationCanceled(const gfx::Animation* animation) {}
+
+void SwipePageTransition::StackAtTop() {
+  if (root_layer_.parent()) {
+    root_layer_.parent()->StackAtTop(&root_layer_);
+  }
+  if (translucent_ && live_content_hidden_) {
+    HideLiveContent();
+  }
+}
+
+void SwipePageTransition::RenderFrameHostChanged(RenderFrameHost* old_host,
+                                                 RenderFrameHost* new_host) {
+  StackAtTop();
+}
+
+void SwipePageTransition::DidFinishNavigation(
+    NavigationHandle* navigation_handle) {
+  if (!navigation_handle->IsInPrimaryMainFrame()) {
+    return;
+  }
+  StackAtTop();
+  if (state_ != State::kCommitting && state_ != State::kHolding) {
+    return;
+  }
+  navigation_done_ = true;
+  MaybeStartDismiss();
+}
+
