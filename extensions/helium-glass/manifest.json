{
  "manifest_version": 3,
  "name": "Helium Glass",
  "version": "0.2.0",
  "description": "Turn website backgrounds into theme-aware translucent surfaces for Helium: With Transparency.",
  "minimum_chrome_version": "120",
  "permissions": ["storage", "scripting", "activeTab"],
  "host_permissions": ["http://*/*", "https://*/*", "file:///*"],
  "background": {"service_worker": "background.js"},
  "action": {
    "default_title": "Helium Glass",
    "default_popup": "popup.html",
    "default_icon": {"16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png"}
  },
  "icons": {"16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png"},
  "content_scripts": [{
    "matches": ["http://*/*", "https://*/*", "file:///*"],
    "js": ["shared.js", "palette.js", "cache.js", "content.js"],
    "run_at": "document_start",
    "all_frames": true
  }]
}
