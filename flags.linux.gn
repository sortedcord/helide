is_official_build=true
symbol_level=1
disable_fieldtrial_testing_config=true
blink_enable_generated_code_formatting=false
blink_symbol_level=0
ffmpeg_branding="Chrome"
proprietary_codecs=true
fatal_linker_warnings=false
rtc_use_pipewire=true
is_clang=true
is_debug=false
use_kerberos=false
use_sysroot=true
use_vaapi=true
use_system_libffi=false
use_siso=true

# Personal build for Intel Core Ultra (Arrow Lake): code generation for this
# CPU, see patches/helium/linux/helium-target-march.patch. The result does not
# run on older CPUs. Remove this line for a generic x86-64 build. PGO is
# enabled separately, with scripts/build.sh --pgo.
helium_target_march = "arrowlake"
